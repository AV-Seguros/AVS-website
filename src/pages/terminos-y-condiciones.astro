---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Términos y condiciones · AV Seguros Real"
  description="Condiciones de uso del sitio de AV Seguros Real y alcance de la información publicada sobre seguros."
  canonicalPath="/terminos-y-condiciones/"
>
  <main class="mx-auto w-full max-w-[1200px] px-6 py-10">
    <Breadcrumbs trail={[{ label: 'Términos y condiciones', href: '/terminos-y-condiciones/' }]} />

    <h1 class="mb-4 text-3xl font-extrabold text-[var(--navy)]">Términos y condiciones</h1>

    <p class="mb-8 max-w-[70ch] text-[var(--text-muted)]">
      Reglas de uso del sitio y límites de la información publicada, que es orientativa y no sustituye
      las condiciones de cada póliza.
    </p>

    <div data-placeholder="content"></div>
  </main>
</BaseLayout>
