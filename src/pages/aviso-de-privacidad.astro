---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aviso de privacidad · AV Seguros Real"
  description="Cómo AV Seguros Real recopila, usa y protege los datos personales de las personas que solicitan una cotización."
  canonicalPath="/aviso-de-privacidad/"
>
  <main class="mx-auto w-full max-w-[1200px] px-6 py-10">
    <nav class="mb-6" aria-label="Ruta de navegación" data-placeholder="breadcrumbs"></nav>

    <h1 class="mb-4 text-3xl font-extrabold text-[var(--navy)]">Aviso de privacidad</h1>

    <p class="mb-8 max-w-[70ch] text-[var(--text-muted)]">
      Información sobre el tratamiento de los datos personales que compartes al solicitar una cotización.
    </p>

    <div data-placeholder="content"></div>
  </main>
</BaseLayout>
