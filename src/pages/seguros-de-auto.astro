---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Testimonials from '../components/Testimonials.astro';
import { siteConfig } from '../config/site';

const PATH = '/seguros-de-auto/';
const pageUrl = new URL(PATH, siteConfig.siteUrl).toString();

// Temporary submission target: the form backend is decided in `1.6.1`
// (ROADMAP §8). This reuses the Formspree endpoint already configured for the
// other site forms. It is intentionally not advertised in the visible copy.
const FORM_ENDPOINT = 'https://formspree.io/f/mgaekvbe';

const whatsappMessage = 'Hola, busco seguro de auto particular. Vengo de la página web.';
const whatsappHref = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const trustSignals = [
  '15 años de experiencia',
  'Respaldo de 40 años (TVAsesores)',
  'Cédula CNSF 649610',
];

const coverageTypes = [
  {
    name: 'Responsabilidad civil (RC)',
    tag: 'La cobertura mínima',
    summary:
      'Paga los daños que tú ocasionas a otras personas y a sus bienes. No repara tu auto.',
    points: [
      'Daños materiales a vehículos de terceros.',
      'Lesiones o muerte de personas en el accidente.',
      'Es la base legal: sin ella, un choque con culpa propia sale de tu bolsillo.',
    ],
  },
  {
    name: 'Cobertura limitada',
    tag: 'El punto medio',
    summary:
      'Suma a la responsabilidad civil el robo total y la pérdida total de tu unidad por accidente.',
    points: [
      'Responsabilidad civil, como en la cobertura mínima.',
      'Robo total del vehículo.',
      'Pérdida total por choque, volcadura o fenómenos naturales, según la póliza.',
      'No cubre daños parciales ni gastos médicos de los ocupantes.',
    ],
  },
  {
    name: 'Cobertura amplia',
    tag: 'La protección completa',
    summary:
      'Cubre los daños materiales de tu auto además de todo lo anterior, y suele incluir gastos médicos a ocupantes y asistencia vial.',
    points: [
      'Daños materiales parciales y totales de tu vehículo.',
      'Robo total y responsabilidad civil.',
      'Gastos médicos a ocupantes, con el límite que marque la póliza.',
      'Asistencia vial y grúas, según el plan contratado.',
    ],
  },
];

const quoteSteps = [
  {
    title: '1. Nos pasas los datos del vehículo',
    description:
      'Marca, modelo, año y versión. Con eso la aseguradora ya puede ubicar el valor comercial y el grupo tarifario.',
  },
  {
    title: '2. Revisamos tu perfil',
    description:
      'Código postal donde duerme el auto, uso real, si eres el propietario y si tienes historial de siniestros. Todo eso mueve la prima.',
  },
  {
    title: '3. Comparamos AXA y Afirme',
    description:
      'Cotizamos las dos opciones con las mismas coberturas y te mostramos el precio lado a lado, con deducible y condiciones a la vista.',
  },
  {
    title: '4. Eliges y pagas directo a la aseguradora',
    description:
      'Nosotros no cobramos la póliza. Una vez que decides, el pago y la emisión se hacen con la aseguradora.',
  },
];

const documents = [
  'Factura o tarjeta de circulación del vehículo.',
  'Identificación oficial del propietario (INE o pasaporte).',
  'Comprobante de domicilio reciente.',
  'Licencia de conducir vigente.',
  'Datos del vehículo: marca, modelo, año, versión y placas.',
  'Historial de siniestros o póliza anterior, si la tienes.',
];

const workProfiles = [
  {
    title: 'Conduces con Uber',
    description:
      'El uso con plataforma suele tarifarse distinto al uso particular. Revisamos qué necesita tu póliza antes de que la app y la aseguradora se contradigan.',
    href: '/seguro-para-uber/',
    cta: 'Ver seguro para Uber',
  },
  {
    title: 'Conduces con DiDi',
    description:
      'Mismo punto de partida: el uso declarado. Te decimos qué revisar en tu póliza si pasas buena parte del día transportando pasajeros.',
    href: '/seguro-para-didi/',
    cta: 'Ver seguro para DiDi',
  },
  {
    title: 'Repartes con auto o moto',
    description:
      'Entrega de mercancías, pedidos y rutas cortas. Si el vehículo trabaja, el uso comercial tiene que estar declarado desde la cotización.',
    href: '/seguros-para-repartidores/',
    cta: 'Ver seguro para repartidores',
  },
];

const faqs = [
  {
    question: '¿Cuál es la cobertura más barata?',
    answer:
      'La responsabilidad civil es la más económica porque solo cubre los daños que ocasionas a terceros: no repara tu auto. La limitada cuesta más porque añade robo y pérdida total, y la amplia es la más cara porque también paga los daños de tu unidad. La prima final depende del vehículo, tu código postal y tu historial, así que la comparación entre coberturas se hace con una cotización en mano.',
  },
  {
    question: '¿Mi seguro de auto cubre Estados Unidos?',
    answer:
      'Depende de la póliza y del plan. Hay coberturas que incluyen circulación en Estados Unidos y Canadá, y otras que solo amparan territorio mexicano. Es uno de los puntos que revisamos contigo en la cotización: si cruzas la frontera seguido, buscamos una opción que lo contemple y te lo confirmamos por escrito antes de contratar.',
  },
  {
    question: '¿Qué pasa si circulo sin seguro?',
    answer:
      'Si tienes un choque con culpa propia y no hay póliza, los daños del otro vehículo, las lesiones y cualquier reclamación salen de tu patrimonio. Además, en la mayoría del país la responsabilidad civil es un requisito para circular y su ausencia puede costarte una multa o la retención del vehículo. La cobertura mínima existe justamente para que un accidente no se convierta en una deuda imposible.',
  },
  {
    question: '¿Qué es el deducible y por qué cambia el precio?',
    answer:
      'El deducible es la cantidad que tú pagas de tu bolsillo cuando usas la cobertura; la aseguradora cubre el resto hasta el límite contratado. Un deducible alto baja la prima, pero encarece cada siniestro. En coberturas amplias también suele aparecer el coaseguro, un porcentaje del daño que corre por tu cuenta. Elegir bien ese par de números importa más que perseguir el precio más bajo.',
  },
  {
    question: '¿Puedo asegurar un auto que no está a mi nombre?',
    answer:
      'Sí, siempre que exista un interés asegurable y la aseguradora lo acepte: por ejemplo, un auto familiar o uno comprado a meses. Lo importante es declararlo desde la cotización, porque en caso de siniestro la aseguradora revisa la propiedad y el uso real del vehículo. Si el auto está a nombre de otra persona, dinos quién es y qué relación tienes con él.',
  },
  {
    question: '¿Cuánto tarda la cotización?',
    answer:
      'Con los datos del vehículo y tu código postal, la comparación entre AXA y Afirme suele estar lista el mismo día. El compromiso es responderte en 24 horas o menos. No hay costo ni obligación de contratar: la cotización es manual, la revisa una persona y te explica las diferencias antes de que decidas.',
  },
];

// Single source of truth: the visible FAQ list and the FAQPage JSON-LD are
// generated from the same `faqs` array.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Seguro de auto en México',
  serviceType: 'Seguro de auto particular',
  description:
    'Asesoría manual para comparar coberturas de seguro de auto en México y contratar la póliza con AXA o Afirme.',
  url: pageUrl,
  areaServed: { '@type': 'Country', name: 'Mexico' },
  provider: {
    '@type': 'InsuranceAgency',
    name: siteConfig.siteName,
    telephone: siteConfig.phone,
    email: siteConfig.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.address.street,
      addressLocality: siteConfig.address.city,
      addressRegion: siteConfig.address.region,
      postalCode: siteConfig.address.postalCode,
      addressCountry: siteConfig.address.country,
    },
  },
};

// Layout and typography tokens mirror the site's design system (see
// `global.scss` and the SCSS section components): 1200px container with
// 1.8rem side padding, 2.1rem section titles, 1.05rem body copy.
const sectionClass = 'landing-container';
const h2Class =
  'text-[1.7rem] font-bold leading-tight tracking-[-0.02em] text-[var(--navy)] md:text-[2.1rem]';
const h3Class = 'mb-2 text-[1.15rem] font-bold text-[var(--navy)]';
const bodyClass = 'max-w-[70ch] text-[1.05rem] leading-relaxed text-[var(--text-muted)]';
const inputClass =
  'w-full rounded-full border border-[#d1d9e6] bg-white px-4 py-3 text-[0.95rem] text-[var(--text-dark)]';
---

<BaseLayout
  title="Seguro de auto en México · AV Seguros Real"
  description="Compara cobertura amplia, limitada y responsabilidad civil con asesoría manual. Pago directo a AXA o Afirme y cotización en 24h."
  canonicalPath={PATH}
  schema={[serviceSchema, faqSchema]}
>
  <main>
    <div class={`${sectionClass} pt-10`}>
      <Breadcrumbs trail={[{ label: 'Seguro de auto', href: PATH }]} />
    </div>

    <!-- Hero -->
    <section class={`${sectionClass} pb-12 pt-2`} aria-labelledby="auto-title">
      <h1
        id="auto-title"
        class="mb-4 max-w-[22ch] text-[1.9rem] font-extrabold leading-[1.15] text-[var(--navy)] md:text-[2.8rem]"
      >
        Seguro de auto en México
      </h1>

      <p class="mb-6 max-w-[62ch] text-[1.1rem] leading-relaxed text-[var(--text-muted)]">
        La cobertura correcta es la que corresponde a tu auto, tu código postal y el uso que
        realmente le das. Cotización manual en 24h, con las coberturas comparadas por una persona y
        no por un comparador automático.
      </p>

      <div class="mb-8 flex flex-wrap items-center gap-3">
        <a
          href="#cotizar"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--red-bright)] px-7 py-3 font-bold text-white transition hover:bg-[var(--red)]"
        >
          <i class="fas fa-file-signature" aria-hidden="true"></i> Cotizar mi seguro
        </a>
        <a
          href={whatsappHref}
          class="inline-flex items-center gap-2 rounded-full border border-[var(--navy)] px-7 py-3 font-semibold text-[var(--navy)] transition hover:bg-[var(--navy)] hover:text-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class="fab fa-whatsapp" aria-hidden="true"></i> Preguntar por WhatsApp
        </a>
      </div>

      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-[var(--navy)]">
        {trustSignals.map((signal) => (
          <li class="flex items-center gap-2">
            <i class="fas fa-check-circle text-[var(--red-bright)]" aria-hidden="true"></i>
            {signal}
          </li>
        ))}
      </ul>

      <p class="mt-6 max-w-[70ch] text-sm text-[var(--text-muted)]">
        Trabajamos con <strong>AXA</strong> y <strong>Afirme</strong>. Somos una agencia, no una
        aseguradora: la póliza la emite y la cobra la aseguradora.
      </p>
    </section>

    <!-- What it is and why it matters -->
    <section class="bg-white py-12" aria-labelledby="que-es-title">
      <div class={sectionClass}>
        <h2 id="que-es-title" class={`${h2Class} mb-4`}>
          Qué es un seguro de auto y por qué importa en México
        </h2>

        <p class={`${bodyClass} mb-4`}>
          Un seguro de auto es un contrato con una aseguradora: tú pagas una prima anual y ella
          responde económicamente cuando ocurre un siniestro cubierto. No es un trámite para poder
          circular, aunque también sirva para eso. Es la diferencia entre un choque que se resuelve
          con una llamada y un choque que se convierte en una deuda de años.
        </p>

        <p class={`${bodyClass} mb-4`}>
          En México la <strong>responsabilidad civil</strong> es la cobertura mínima que la autoridad
          pide para circular, y se revisa en carreteras federales y en operativos de varios estados.
          Esa cobertura solo paga los daños que causas a otras personas y a sus bienes: no arregla tu
          auto. Por eso la mayoría de los propietarios termina en una cobertura limitada o amplia.
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Protege tu patrimonio</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Un daño a un tercero puede costar más que el auto. La póliza pone un límite a lo que
              tendrías que pagar de tu bolsillo.
            </p>
          </div>
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Te deja seguir con tu día</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Grúas, asistencia vial y ajustadores existen para que el accidente no te detenga una
              semana entera resolviendo trámites.
            </p>
          </div>
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Cumple con la ley</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Circular sin la cobertura exigida puede costarte una multa o la retención del
              vehículo, además del daño que causes.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage types -->
    <section class="py-12" aria-labelledby="coberturas-title">
      <div class={sectionClass}>
        <h2 id="coberturas-title" class={`${h2Class} mb-4`}>Tipos de cobertura, de la mínima a la más completa</h2>

        <p class={`${bodyClass} mb-8`}>
          Los nombres cambian de una aseguradora a otra, pero la lógica es la misma: cada nivel suma
          protección y sube la prima. Estas son las tres familias que vas a encontrar al cotizar.
        </p>

        <div class="grid gap-6 md:grid-cols-3">
          {
            coverageTypes.map((coverage) => (
              <div class="flex flex-col rounded-2xl border border-[#e2e8f0] bg-white p-6">
                <span class="mb-2 inline-flex w-fit rounded-full bg-[var(--gray-bg)] px-3 py-1 text-xs font-bold uppercase tracking-wide text-[var(--red)]">
                  {coverage.tag}
                </span>
                <h3 class={h3Class}>{coverage.name}</h3>
                <p class="mb-4 text-sm text-[var(--text-muted)]">{coverage.summary}</p>
                <ul class="mt-auto list-disc space-y-2 pl-5 text-sm text-[var(--text-muted)]">
                  {coverage.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            ))
          }
        </div>

        <p class="mt-6 max-w-[70ch] rounded-2xl border-l-4 border-[var(--red-bright)] bg-[var(--gray-bg)] p-4 text-sm text-[var(--navy)]">
          <i class="fas fa-info-circle text-[var(--red-bright)]" aria-hidden="true"></i>
          Lo que cubre cada nivel lo define el condicionado general de la aseguradora, no el nombre
          comercial del plan. En la cotización te mostramos las condiciones del plan que estás
          comparando antes de que decidas.
        </p>
      </div>
    </section>

    <!-- Deductibles -->
    <section class="bg-white py-12" aria-labelledby="deducible-title">
      <div class={sectionClass}>
        <h2 id="deducible-title" class={`${h2Class} mb-4`}>Deducible y coaseguro: lo que pagas tú</h2>

        <p class={`${bodyClass} mb-6`}>
          El precio de una póliza no se entiende sin estos dos números. Son la parte del siniestro que
          corre por tu cuenta, y son la razón por la que dos cotizaciones con la misma cobertura pueden
          diferir tanto.
        </p>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Deducible</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Es la cantidad fija, o el porcentaje del valor del auto, que pagas tú cada vez que usas
              la cobertura de daños materiales. Si el deducible es del 5% sobre un auto de $300,000,
              tu parte son $15,000 y la aseguradora cubre el resto hasta el límite del plan.
            </p>
          </div>
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Coaseguro</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Es un porcentaje adicional que compartes con la aseguradora en algunos ramos o
              coberturas, por ejemplo gastos médicos. No todos los planes lo llevan: cuando aparece,
              está escrito en la carátula y en el condicionado.
            </p>
          </div>
        </div>

        <p class="mt-6 max-w-[70ch] text-[1.05rem] leading-relaxed text-[var(--text-muted)]">
          La regla práctica: un deducible alto baja la prima y encarece el siniestro; uno bajo hace lo
          contrario. Lo sensato es elegirlo pensando en cuánto podrías pagar hoy sin descapitalizarte,
          no en el precio mensual más bajo.
        </p>

        <!-- TODO(1.3.1): link to /herramientas/calculadora-deducible/ once the tool ships -->
        <p class="mt-4 max-w-[70ch] text-sm text-[var(--text-muted)]">
          Estamos preparando una calculadora de deducible para que hagas tú mismo el cálculo con el
          valor de tu auto. Mientras tanto, pídenos el ejemplo numérico en la cotización y te lo
          mandamos con las dos aseguradoras comparadas.
        </p>
      </div>
    </section>

    <!-- Quotation process + documents -->
    <section class="py-12" aria-labelledby="proceso-title">
      <div class={sectionClass}>
        <h2 id="proceso-title" class={`${h2Class} mb-4`}>Cómo funciona la cotización</h2>
        <p class={`${bodyClass} mb-8`}>
          Sin formularios eternos ni llamadas de robot. Cuatro pasos y una persona responsable de tu
          caso de principio a fin.
        </p>

        <ol class="grid gap-6 md:grid-cols-2">
          {
            quoteSteps.map((step) => (
              <li class="rounded-2xl border border-[#e2e8f0] bg-white p-6">
                <h3 class={h3Class}>{step.title}</h3>
                <p class="text-sm text-[var(--text-muted)]">{step.description}</p>
              </li>
            ))
          }
        </ol>

        <div class="mt-10">
          <h3 class={h3Class}>Qué documentos necesitas</h3>
          <ul class="max-w-[70ch] list-disc space-y-2 pl-5 text-[var(--text-muted)]">
            {documents.map((document) => <li>{document}</li>)}
          </ul>
          <p class="mt-4 max-w-[70ch] text-sm text-[var(--text-muted)]">
            Para cotizar bastan los datos del vehículo y tu código postal. Los documentos se piden al
            momento de emitir la póliza, no antes.
          </p>
        </div>
      </div>
    </section>

    <!-- Work use -->
    <section class="bg-white py-12" aria-labelledby="trabajo-title">
      <div class={sectionClass}>
        <h2 id="trabajo-title" class={`${h2Class} mb-4`}>
          Si usas el auto para trabajar, esta no es tu página
        </h2>

        <p class={`${bodyClass} mb-8`}>
          Un auto que transporta pasajeros o entrega pedidos no tiene el mismo riesgo que uno que va
          de la casa al trabajo. Si ese es tu caso, empieza por la página que corresponde: ahí
          explicamos qué revisar en el uso declarado y qué suele pedir la aseguradora.
        </p>

        <div class="grid gap-6 md:grid-cols-3">
          {
            workProfiles.map((profile) => (
              <div class="flex flex-col rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
                <h3 class={h3Class}>{profile.title}</h3>
                <p class="mb-4 text-sm text-[var(--text-muted)]">{profile.description}</p>
                <a
                  href={profile.href}
                  class="mt-auto inline-flex items-center gap-2 text-sm font-bold text-[var(--red)] hover:underline"
                >
                  {profile.cta} <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Price and payment -->
    <section class="py-12" aria-labelledby="costo-title">
      <div class={sectionClass}>
        <h2 id="costo-title" class={`${h2Class} mb-4`}>Cuánto cuesta y cómo se paga</h2>

        <p class={`${bodyClass} mb-6`}>
          Para un auto particular, el costo promedio anual ronda entre los{' '}
          <strong>$20,000 y $30,000 MXN</strong>. El monto exacto lo confirma la cotización de la
          aseguradora: depende del modelo, el año, el código postal, el uso declarado, el deducible y
          las coberturas que elijas.
        </p>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Pagos con tarjeta de crédito</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Mensual o trimestral, con cargo a tu tarjeta de crédito.
            </p>
          </div>
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={h3Class}>Pago directo</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Semestral o anual, pagando directamente a la aseguradora.
            </p>
          </div>
        </div>

        <p class="mt-6 max-w-[70ch] rounded-2xl border-l-4 border-[var(--red-bright)] bg-[var(--gray-bg)] p-4 text-sm text-[var(--navy)]">
          <i class="fas fa-shield-alt text-[var(--red-bright)]" aria-hidden="true"></i>
          <strong>No recibimos tu dinero:</strong> pagas directo a AXA o Afirme.
        </p>
      </div>
    </section>

    <!-- Form -->
    <section id="cotizar" class="bg-white py-12" aria-labelledby="cotizar-title">
      <div class={sectionClass}>
        <div class="mx-auto max-w-[640px]">
          <h2 id="cotizar-title" class={`${h2Class} mb-3`}>Solicita tu cotización</h2>
          <p class={`${bodyClass} mb-6`}>
            Tres datos y un agente real te contacta en 24h o menos para revisar tu caso.
          </p>

          <form
            id="autoLeadForm"
            class="rounded-2xl border border-[#e2e8f0] bg-white p-6 md:p-8"
            action={FORM_ENDPOINT}
            method="POST"
            novalidate
          >
            <input type="hidden" name="_subject" value="Cotización seguro de auto - AV Seguros Real" />
            <input type="hidden" name="_source" value="seguros-de-auto" />

            <div class="mb-4">
              <label for="auto-nombre" class="mb-1 block text-sm font-semibold text-[var(--navy)]">
                Nombre *
              </label>
              <input
                type="text"
                id="auto-nombre"
                name="Nombre"
                autocomplete="name"
                class={inputClass}
                aria-describedby="auto-nombre-error"
                required
              />
              <p id="auto-nombre-error" class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
                Escribe tu nombre.
              </p>
            </div>

            <div class="mb-4">
              <label for="auto-whatsapp" class="mb-1 block text-sm font-semibold text-[var(--navy)]">
                WhatsApp *
              </label>
              <input
                type="tel"
                id="auto-whatsapp"
                name="WhatsApp"
                inputmode="tel"
                autocomplete="tel"
                placeholder="81 1234 5678"
                class={inputClass}
                aria-describedby="auto-whatsapp-error"
                required
              />
              <p id="auto-whatsapp-error" class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
                Escribe un número de WhatsApp de al menos 10 dígitos.
              </p>
            </div>

            <div class="mb-4">
              <label for="auto-email" class="mb-1 block text-sm font-semibold text-[var(--navy)]">
                Correo electrónico *
              </label>
              <input
                type="email"
                id="auto-email"
                name="Email"
                autocomplete="email"
                class={inputClass}
                aria-describedby="auto-email-error"
                required
              />
              <p id="auto-email-error" class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
                Escribe un correo electrónico válido.
              </p>
            </div>

            <div class="mb-6">
              <label for="auto-consent" class="flex items-start gap-3 text-sm text-[var(--text-muted)]">
                <input
                  type="checkbox"
                  id="auto-consent"
                  name="Consentimiento"
                  value="Aceptado"
                  class="mt-1 h-4 w-4"
                  aria-describedby="auto-consent-error"
                  required
                />
                <span>
                  Acepto el
                  <a href="/aviso-de-privacidad/" class="font-semibold text-[var(--red)] underline">
                    aviso de privacidad</a
                  >
                  y el contacto por WhatsApp o correo para recibir mi cotización.
                </span>
              </label>
              <p id="auto-consent-error" class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
                Necesitamos tu consentimiento para contactarte.
              </p>
            </div>

            <button
              type="submit"
              id="autoSubmitBtn"
              class="w-full rounded-full bg-[var(--red-bright)] px-6 py-3 font-bold text-white transition hover:bg-[var(--red)]"
            >
              <i class="fas fa-paper-plane" aria-hidden="true"></i> Enviar solicitud
            </button>

            <p id="auto-form-error" class="mt-4 hidden text-sm text-[var(--red)]" role="alert">
              No pudimos enviar tu solicitud.
              <a
                href={whatsappHref}
                class="font-bold underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                Escríbenos por WhatsApp</a
              >
              y lo vemos de inmediato.
            </p>

            <p class="mt-4 text-xs text-[var(--text-muted)]">
              Tus datos se usan solo para contactarte sobre esta cotización.
            </p>
          </form>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="py-12" aria-labelledby="auto-faq-title">
      <div class={sectionClass}>
        <h2 id="auto-faq-title" class={`${h2Class} mb-6`}>Preguntas frecuentes</h2>

        <div class="mx-auto max-w-[820px] space-y-3">
          {
            faqs.map((faq) => (
              <details class="rounded-xl border-l-4 border-[var(--red-bright)] bg-[var(--gray-card)] p-5">
                <summary class="cursor-pointer font-bold text-[var(--navy)]">{faq.question}</summary>
                <p class="mt-3 text-[var(--text-muted)]">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TODO: Replace with real car insurance client testimonials -->
    <Testimonials />

    <!-- Closing CTA -->
    <section class="bg-white py-12" aria-labelledby="cierre-title">
      <div class={`${sectionClass} text-center`}>
        <h2 id="cierre-title" class={`${h2Class} mb-3`}>Cotiza con un agente real</h2>
        <p class="mx-auto mb-6 max-w-[60ch] text-[var(--text-muted)]">
          Revisamos tu auto, comparamos AXA y Afirme con las mismas coberturas y te decimos qué plan
          te conviene según el uso que le das.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="#cotizar"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--red-bright)] px-7 py-3 font-bold text-white transition hover:bg-[var(--red)]"
          >
            <i class="fas fa-file-signature" aria-hidden="true"></i> Cotizar mi seguro
          </a>
          <a
            href={whatsappHref}
            class="inline-flex items-center gap-2 rounded-full border border-[var(--navy)] px-7 py-3 font-semibold text-[var(--navy)] transition hover:bg-[var(--navy)] hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  // Shared page container: 1200px max width with the same responsive side
  // padding as the section components in `src/components`.
  .landing-container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.2rem;

    @media (min-width: 541px) {
      padding-inline: 1.8rem;
    }
  }
</style>

<script>
  (function () {
    const form = document.getElementById('autoLeadForm') as HTMLFormElement | null;
    const btn = document.getElementById('autoSubmitBtn') as HTMLButtonElement | null;
    const formError = document.getElementById('auto-form-error');
    if (!form || !btn) return;

    const nameInput = document.getElementById('auto-nombre') as HTMLInputElement;
    const phoneInput = document.getElementById('auto-whatsapp') as HTMLInputElement;
    const emailInput = document.getElementById('auto-email') as HTMLInputElement;
    const consentInput = document.getElementById('auto-consent') as HTMLInputElement;

    const setFieldError = (input: HTMLInputElement, errorId: string, hasError: boolean) => {
      const error = document.getElementById(errorId);
      error?.classList.toggle('hidden', !hasError);
      input.setAttribute('aria-invalid', String(hasError));
    };

    const isPhoneValid = (value: string) => value.replace(/\D/g, '').length >= 10;
    const isEmailValid = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value.trim());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formError?.classList.add('hidden');

      const hasName = nameInput.value.trim().length >= 2;
      const hasPhone = isPhoneValid(phoneInput.value);
      const hasEmail = isEmailValid(emailInput.value);
      const hasConsent = consentInput.checked;

      setFieldError(nameInput, 'auto-nombre-error', !hasName);
      setFieldError(phoneInput, 'auto-whatsapp-error', !hasPhone);
      setFieldError(emailInput, 'auto-email-error', !hasEmail);
      setFieldError(consentInput, 'auto-consent-error', !hasConsent);

      const firstInvalid = [!hasName, !hasPhone, !hasEmail, !hasConsent].indexOf(true);
      if (firstInvalid !== -1) {
        [nameInput, phoneInput, emailInput, consentInput][firstInvalid].focus();
        return;
      }

      const originalLabel = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Enviando...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Submission failed');

        window.location.href = `${import.meta.env.BASE_URL}gracias`;
      } catch {
        formError?.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = originalLabel;
      }
    });
  })();
</script>
