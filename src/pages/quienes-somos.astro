---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Quiénes somos · AV Seguros Real"
  description="AV Seguros Real es una agencia de seguros con atención personal y respaldo de AXA y Afirme en Nuevo León."
  canonicalPath="/quienes-somos/"
>
  <main class="mx-auto w-full max-w-[1200px] px-6 py-10">
    <Breadcrumbs trail={[{ label: 'Quiénes somos', href: '/quienes-somos/' }]} />

    <h1 class="mb-4 text-3xl font-extrabold text-[var(--navy)]">Quiénes somos</h1>

    <p class="mb-8 max-w-[70ch] text-[var(--text-muted)]">
      Una agencia que atiende personas, no un cotizador automático: cada solicitud la revisa un asesor.
    </p>

    <div data-placeholder="content"></div>
  </main>
</BaseLayout>
