---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Servicios de seguros · AV Seguros Real"
  description="Seguros de auto, vida, hogar, negocio y gastos médicos con asesoría personal y respaldo de AXA y Afirme."
  canonicalPath="/servicios/"
>
  <main class="mx-auto w-full max-w-[1200px] px-6 py-10">
    <nav class="mb-6" aria-label="Ruta de navegación" data-placeholder="breadcrumbs"></nav>

    <h1 class="mb-4 text-3xl font-extrabold text-[var(--navy)]">Servicios</h1>

    <p class="mb-8 max-w-[70ch] text-[var(--text-muted)]">
      Acompañamiento personal para elegir el seguro que corresponde a tu vehículo, tu patrimonio o tu
      negocio.
    </p>

    <div data-placeholder="content"></div>
  </main>
</BaseLayout>
