---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';
import ArticleCTA from '../../components/blog/ArticleCTA.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  BLOG_PATH,
  blogCategoryPath,
  blogPostPath,
  formatBlogDate,
  readingTimeLabel,
} from '../../config/blog';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  // Drafts have no route at all, so an unpublished article cannot be reached
  // by guessing its URL.
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => {
    // Related articles come from the same category only, never the current one,
    // newest first, at most three.
    const related = posts
      .filter(
        (candidate) =>
          candidate.id !== post.id && candidate.data.category === post.data.category,
      )
      .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
      .slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, related },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);

const PATH = blogPostPath(post.id);
const categoryPath = blogCategoryPath(post.data.category);
const canonicalUrl = new URL(PATH, siteConfig.siteUrl).toString();
const publishDate = post.data.publishDate.toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishDate,
  dateModified: publishDate,
  inLanguage: 'es-MX',
  articleSection: post.data.category,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  author: {
    '@type': 'Person',
    name: siteConfig.advisorName,
    url: new URL('/quienes-somos/', siteConfig.siteUrl).toString(),
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteConfig.siteUrl}/#organization`,
    name: siteConfig.siteName,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', siteConfig.siteUrl).toString(),
    },
  },
  ...(post.data.heroImage
    ? { image: new URL(post.data.heroImage, siteConfig.siteUrl).toString() }
    : {}),
  ...(post.data.keywords ? { keywords: post.data.keywords.join(', ') } : {}),
};
---

<BaseLayout
  title={`${post.data.title} · ${siteConfig.siteName}`}
  description={post.data.description}
  canonicalPath={PATH}
  ogImage={post.data.heroImage}
  schema={[articleSchema]}
>
  <main class="mx-auto w-full max-w-[760px] px-6 py-10">
    <Breadcrumbs
      trail={[
        { label: 'Blog', href: BLOG_PATH },
        { label: post.data.category, href: categoryPath },
        { label: post.data.title, href: PATH },
      ]}
    />

    <article>
      <header class="mb-8 border-b border-[#e2e8f0] pb-6">
        <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-bold uppercase tracking-[0.08em]">
          <a href={categoryPath} class="text-[var(--red)] hover:underline">
            {post.data.category}
          </a>
          <time
            datetime={publishDate}
            class="font-medium normal-case tracking-normal text-[var(--text-muted)]"
          >
            {formatBlogDate(post.data.publishDate)}
          </time>
        </p>

        <h1 class="mb-3 text-3xl font-extrabold leading-tight text-[var(--navy)] sm:text-4xl">
          {post.data.title}
        </h1>

        <p class="mb-3 text-sm font-medium text-[var(--text-muted)]">
          {readingTimeLabel(post.body)}
        </p>

        <p class="text-lg leading-relaxed text-[var(--text-muted)]">{post.data.description}</p>
      </header>

      {post.data.heroImage && (
        <img
          src={post.data.heroImage}
          alt=""
          class="mb-8 w-full rounded-2xl"
          loading="lazy"
          decoding="async"
        />
      )}

      <div class="article-body">
        <Content />
      </div>

      <ArticleCTA />

      <p class="mt-8 text-xs leading-relaxed text-[var(--text-muted)]">
        Este artículo es información educativa y no sustituye las condiciones de una póliza ni la
        asesoría de la aseguradora.
      </p>
    </article>

    {
      related.length > 0 && (
        <section class="mt-12" aria-labelledby="related-articles">
          <h2 id="related-articles" class="mb-4 text-2xl font-bold text-[var(--navy)]">
            Artículos relacionados
          </h2>
          <ul class="grid gap-6 sm:grid-cols-2">
            {related.map((item) => (
              <li class="flex">
                <ArticleCard post={item} />
              </li>
            ))}
          </ul>
          <p class="mt-5 text-sm">
            <a href={categoryPath} class="font-semibold text-[var(--red)] hover:underline">
              Ver todos los artículos de {post.data.category}
            </a>
          </p>
        </section>
      )
    }
  </main>
</BaseLayout>

<style lang="scss">
  // Markdown output is injected as raw HTML, so the typography rules have to be
  // written as global selectors scoped by the `.article-body` wrapper.
  .article-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-dark);

    :global(> * + *) {
      margin-top: 1.1rem;
    }

    :global(h2) {
      margin-top: 2.2rem;
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.3;
      color: var(--navy);
    }

    :global(h3) {
      margin-top: 1.6rem;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--navy);
    }

    :global(p),
    :global(li) {
      color: var(--text-muted);
    }

    :global(ul),
    :global(ol) {
      padding-left: 1.4rem;
      list-style: disc;
    }

    :global(ol) {
      list-style: decimal;
    }

    :global(li + li) {
      margin-top: 0.45rem;
    }

    :global(strong) {
      color: var(--text-dark);
      font-weight: 700;
    }

    :global(a) {
      color: var(--red);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;

      &:hover {
        color: var(--navy);
      }
    }

    :global(blockquote) {
      border-left: 3px solid var(--red-bright);
      padding-left: 1rem;
      font-style: italic;
    }

    @media (max-width: 480px) {
      font-size: 1rem;
    }
  }
</style>
