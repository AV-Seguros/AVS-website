---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { BLOG_PATH, blogPostPath, formatBlogDate } from '../../config/blog';

const PATH = BLOG_PATH;

// Drafts never reach the index, and neither route publishes them.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const pageTitle = 'Blog de seguros: guías y consejos | AV Seguros Real';
const pageDescription =
  'Guías claras sobre seguros de auto, coberturas, siniestros y renovaciones en México, escritas por un agente de seguros con respaldo AXA y Afirme.';
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalPath={PATH}>
  <main class="mx-auto w-full max-w-[1100px] px-6 py-10">
    <Breadcrumbs trail={[{ label: 'Blog', href: PATH }]} />

    <header class="mb-10 max-w-[70ch]">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.1em] text-[var(--red)]">
        Centro de educación
      </p>
      <h1 class="mb-3 text-3xl font-extrabold leading-tight text-[var(--navy)] sm:text-4xl">
        Blog de seguros
      </h1>
      <p class="text-[var(--text-muted)]">
        Explicaciones sin letra chiquita: qué cubre cada póliza, cómo funciona un deducible y qué
        hacer cuando ocurre un siniestro. Escrito para que puedas decidir con información concreta.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="rounded-2xl border border-[#e2e8f0] bg-white p-6 text-[var(--text-muted)]">
          Estamos preparando los primeros artículos.
        </p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="flex">
              <article class="flex w-full flex-col rounded-2xl border border-[#e2e8f0] bg-white p-6 transition hover:-translate-y-0.5 hover:border-[var(--red-bright)] hover:shadow-[0_18px_40px_rgba(11,37,69,0.10)]">
                <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-bold uppercase tracking-[0.08em] text-[var(--red)]">
                  <span>{post.data.category}</span>
                  <time datetime={post.data.publishDate.toISOString()} class="font-medium normal-case tracking-normal text-[var(--text-muted)]">
                    {formatBlogDate(post.data.publishDate)}
                  </time>
                </p>

                <h2 class="mb-2 text-lg font-bold leading-snug text-[var(--navy)]">
                  <a href={blogPostPath(post.id)} class="hover:text-[var(--red)]">
                    {post.data.title}
                  </a>
                </h2>

                <p class="mb-5 text-sm leading-relaxed text-[var(--text-muted)]">
                  {post.data.description}
                </p>

                <a
                  href={blogPostPath(post.id)}
                  class="mt-auto inline-flex items-center gap-2 text-sm font-bold text-[var(--red)] hover:underline"
                >
                  Leer artículo
                  <i class="fas fa-arrow-right text-[0.7rem]" aria-hidden="true" />
                </a>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
