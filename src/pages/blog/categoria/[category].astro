---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleCard from '../../../components/blog/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_INFO,
  BLOG_PATH,
  blogCategoryPath,
  blogPostPath,
  type BlogCategory,
} from '../../../config/blog';
import { siteConfig } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  // Every category gets a route, including the ones without articles yet; the
  // page renders an empty state instead of 404 so the navigation never breaks.
  return BLOG_CATEGORIES.map((category) => ({
    params: { category: BLOG_CATEGORY_INFO[category].slug },
    props: {
      category,
      posts: posts
        .filter((post) => post.data.category === category)
        .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
    },
  }));
}

interface Props {
  category: BlogCategory;
  posts: CollectionEntry<'blog'>[];
}

const { category, posts } = Astro.props;

const PATH = blogCategoryPath(category);
const description = BLOG_CATEGORY_INFO[category].description;
const canonicalUrl = new URL(PATH, siteConfig.siteUrl).toString();

const pageTitle = `${category}: artículos del blog · ${siteConfig.siteName}`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalUrl}#collection`,
  name: `${category} · Blog de ${siteConfig.siteName}`,
  description,
  url: canonicalUrl,
  inLanguage: 'es-MX',
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${siteConfig.siteUrl}/#website`,
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  },
  ...(posts.length > 0
    ? {
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: posts.length,
          itemListElement: posts.map((post, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: post.data.title,
            url: new URL(blogPostPath(post.id), siteConfig.siteUrl).toString(),
          })),
        },
      }
    : {}),
};
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonicalPath={PATH}
  schema={[collectionSchema]}
>
  <main class="mx-auto w-full max-w-[1100px] px-6 py-10">
    <Breadcrumbs
      trail={[
        { label: 'Blog', href: BLOG_PATH },
        { label: category, href: PATH },
      ]}
    />

    <header class="mb-10 max-w-[70ch]">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.1em] text-[var(--red)]">Categoría</p>
      <h1 class="mb-3 text-3xl font-extrabold leading-tight text-[var(--navy)] sm:text-4xl">
        {category}
      </h1>
      <p class="text-[var(--text-muted)]">{description}</p>
    </header>

    {
      posts.length === 0 ? (
        <div class="rounded-2xl border border-[#e2e8f0] bg-white p-6">
          <p class="mb-3 text-[var(--text-muted)]">
            Todavía no hay artículos publicados en esta categoría. Estamos preparando las primeras
            guías.
          </p>
          <a href={BLOG_PATH} class="text-sm font-bold text-[var(--red)] hover:underline">
            Ver todos los artículos del blog
          </a>
        </div>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li class="flex">
              <ArticleCard post={post} />
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-8 text-sm">
      <a href={BLOG_PATH} class="font-semibold text-[var(--red)] hover:underline">
        ← Volver al blog
      </a>
    </p>
  </main>
</BaseLayout>
