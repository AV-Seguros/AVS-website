---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import Brands from '../components/Brands.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import FAQ from '../components/FAQ.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { buildWhatsAppUrl } from '../scripts/whatsapp';

const whatsappHref = buildWhatsAppUrl('contacto');
---

<BaseLayout
  title="Seguro de auto en México | AV Seguros Real"
  description="Cotiza tu seguro de auto en México con AXA y Afirme. Asesoría 100% manual con agente real, cobertura en todo el país. Cotiza gratis en 24h."
  canonicalPath="/"
>
  <Hero />
  <Testimonials />
  <AboutUs />
  <Services />
  <Brands />
  <LeadForm
    source="home-contact"
    context="Sección de contacto de la página de inicio"
    sectionId="contacto"
    tone="navy"
    heading="Solicita tu cotización"
    description="Rellena el formulario y en 24h o menos un agente real se pondrá en contacto contigo."
    whatsappHref={whatsappHref}
  />
  <FAQ />
  <WhatsAppFloat />
</BaseLayout>
