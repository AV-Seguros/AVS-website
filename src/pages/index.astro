---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import AboutUs from '../components/AboutUs.astro';
import Services from '../components/Services.astro';
import Brands from '../components/Brands.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<BaseLayout
  title="Seguro de auto en México | AV Seguros Real"
  description="Cotiza tu seguro de auto con AXA y Afirme. Asesoría 100% manual con agente real. Cobertura en todo México. Cotiza gratis en 24h."
  canonicalPath="/"
>
  <Hero />
  <Testimonials />
  <AboutUs />
  <Services />
  <Brands />
  <ContactForm />
  <FAQ />
  <WhatsAppFloat />
</BaseLayout>
