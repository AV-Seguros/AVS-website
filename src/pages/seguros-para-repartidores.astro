  // Shared page container: 1200px max width with the same responsive side
  // padding as the section components in `src/components`.
  .landing-container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 1.2rem;

    @media (min-width: 541px) {
      padding-inline: 1.8rem;
    }
  }
</style>

<script>
  (function () {
    const form = document.getElementById('repartidoresLeadForm') as HTMLFormElement | null;
    const btn = document.getElementById('repartidoresSubmitBtn') as HTMLButtonElement | null;
    const formError = document.getElementById('repartidores-form-error');
    if (!form || !btn) return;

    const nameInput = document.getElementById('repartidores-nombre') as HTMLInputElement;
    const phoneInput = document.getElementById('repartidores-whatsapp') as HTMLInputElement;
    const emailInput = document.getElementById('repartidores-email') as HTMLInputElement;
    const consentInput = document.getElementById('repartidores-consent') as HTMLInputElement;

    const setFieldError = (input: HTMLInputElement, errorId: string, hasError: boolean) => {
      const error = document.getElementById(errorId);
      error?.classList.toggle('hidden', !hasError);
      input.setAttribute('aria-invalid', String(hasError));
    };

    const isPhoneValid = (value: string) => value.replace(/\D/g, '').length >= 10;
    const isEmailValid = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value.trim());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formError?.classList.add('hidden');

      const hasName = nameInput.value.trim().length >= 2;
      const hasPhone = isPhoneValid(phoneInput.value);
      const hasEmail = isEmailValid(emailInput.value);
      const hasConsent = consentInput.checked;

      setFieldError(nameInput, 'repartidores-nombre-error', !hasName);
      setFieldError(phoneInput, 'repartidores-whatsapp-error', !hasPhone);
      setFieldError(emailInput, 'repartidores-email-error', !hasEmail);
      setFieldError(consentInput, 'repartidores-consent-error', !hasConsent);

      const firstInvalid = [!hasName, !hasPhone, !hasEmail, !hasConsent].indexOf(true);
      if (firstInvalid !== -1) {
        [nameInput, phoneInput, emailInput, consentInput][firstInvalid].focus();
        return;
      }

      const originalLabel = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Enviando...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('Submission failed');

        window.location.href = `${import.meta.env.BASE_URL}gracias`;
      } catch {
        formError?.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = originalLabel;
      }
    });
  })();
</script>
