---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LandingFAQ from '../components/landing/LandingFAQ.astro';
import LandingForm from '../components/landing/LandingForm.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingTestimonials from '../components/landing/LandingTestimonials.astro';
import { landingTokens as t } from '../components/landing/tokens';
import { siteConfig } from '../config/site';

const PATH = '/seguro-para-didi/';
const pageUrl = new URL(PATH, siteConfig.siteUrl).toString();

const whatsappMessage = 'Hola, busco seguro de auto para conductor de DiDi. Vengo de la página web.';
const whatsappHref = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const trustSignals = [
  '15 años de experiencia',
  'Respaldo de 40 años (TVAsesores)',
  'Cédula CNSF 649610',
];

const benefits = [
  {
    title: 'Cobertura en USA y Canadá',
    description:
      'Uno de nuestros fuertes: tu póliza puede acompañarte cuando cruzas la frontera. Pregunta por las condiciones aplicables a tu caso.',
  },
  {
    title: '2 grúas al año en todo México',
    description:
      'Asistencia vial en todo el país, dos servicios de grúa por año. Las ponchaduras no están incluidas.',
  },
  {
    title: 'Daños a terceros como póliza mínima',
    description:
      'La base de cualquier póliza responsable: cubrir el daño que ocasionas a otros vehículos, a bienes y a personas.',
  },
];

const policyChecks = [
  'El uso declarado del vehículo: particular, comercial o para plataformas de transporte.',
  'Las exclusiones que mencionan transporte de pasajeros remunerado.',
  'Si la aseguradora pide una ampliación o endoso para operar con una aplicación.',
  'La vigencia de la póliza y la fecha real de renovación.',
];

const faqs = [
  {
    question: '¿La protección que muestra la app de DiDi sustituye un seguro de auto?',
    answer:
      'No es equivalente a una póliza de auto contratada por ti. Las condiciones de cualquier protección que ofrezca la plataforma las define la plataforma y su aseguradora, no nosotros, y suelen limitarse a lo que ocurre durante un viaje. Una póliza propia protege tu patrimonio también cuando el auto está estacionado, cuando lo usas de forma personal y frente a daños a terceros. Confirma por escrito qué cubre cada cosa antes de asumir que estás protegido.',
  },
  {
    question: '¿Puedo seguir con mi póliza de uso privado si manejo con DiDi?',
    answer:
      'Es justo el punto que hay que revisar. Una póliza de uso privado se tarifa para traslados personales; operar con una aplicación puede considerarse uso comercial. Si el uso declarado no coincide con el real, la aseguradora puede no responder ante un siniestro ocurrido mientras trabajabas. Te ayudamos a declararlo correctamente desde la cotización.',
  },
  {
    question: '¿Cubren en USA y Canadá?',
    answer:
      'Sí, es uno de nuestros fuertes. Te confirmamos por escrito qué coberturas aplican cuando cruzas la frontera y cómo se comporta la asistencia fuera del país antes de que contrates.',
  },
  {
    question: '¿Qué incluye la asistencia?',
    answer:
      'Dos servicios de grúa al año en todo México. Las ponchaduras no están incluidas, así que conviene revisar qué otros servicios de asistencia necesitas por tu cuenta.',
  },
  {
    question: '¿Qué hago en caso de siniestro?',
    answer:
      'Nos llamas y te guiamos en el reporte y en el proceso con la aseguradora. También damos seguimiento y presionamos al taller para que tu unidad te sea entregada lo antes posible.',
  },
  {
    question: '¿Quién cobra el seguro?',
    answer:
      'AXA o Afirme directamente, nunca nosotros. No recibimos tu dinero: tú pagas directo a la aseguradora. Y si trabajas con DiDi, el pago de tu póliza y el de la plataforma son independientes.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Seguro de auto para conductores de DiDi',
  serviceType: 'Seguro de auto para conductores de plataformas de transporte',
  description:
    'Asesoría manual para contratar un seguro de auto con la cobertura de uso comercial que exige manejar para plataformas de transporte en México.',
  url: pageUrl,
  areaServed: { '@type': 'Country', name: 'Mexico' },
  provider: {
    '@type': 'InsuranceAgency',
    name: siteConfig.siteName,
    telephone: siteConfig.phone,
    email: siteConfig.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: siteConfig.address.street,
      addressLocality: siteConfig.address.city,
      addressRegion: siteConfig.address.region,
      postalCode: siteConfig.address.postalCode,
      addressCountry: siteConfig.address.country,
    },
  },
};
---

<BaseLayout
  title="Seguro de auto para conductores de DiDi · AV Seguros Real"
  description="Cotiza seguro de auto para conductor de DiDi con asesoría manual en 24h. Revisamos el uso comercial de tu vehículo y pagas directo a AXA o Afirme."
  canonicalPath={PATH}
  schema={[serviceSchema]}
>
  <main>
    <div class={`${t.container} pt-10`}>
      <Breadcrumbs trail={[{ label: 'Seguro para DiDi', href: PATH }]} />
    </div>

    <LandingHero
      headingId="didi-title"
      title="Seguro de auto para conductores de DiDi en México"
      titleClass="max-w-[20ch]"
      subtitle="Cotización manual en 24h. Antes de asumir que la app te cubre, revisemos qué dice tu póliza."
      trustSignals={trustSignals}
      whatsappHref={whatsappHref}
      notes={[
        'No estamos afiliados a DiDi ni hablamos en su nombre: los conductores de la plataforma son clientes con una necesidad de cobertura concreta.',
      ]}
      bgImage="/images/heroes/didi-bg.png"
      overlayClass="bg-gradient-to-r from-white/95 via-white/70 to-transparent"
      textTheme="dark"
    />

    <!-- Educational section 1 -->
    <section class="bg-white py-12" aria-labelledby="cubre-didi-title">
      <div class={t.container}>
        <h2 id="cubre-didi-title" class={`${t.h2} mb-4`}>
          ¿Qué cubre la app y qué cubre tu póliza?
        </h2>

        <p class={`${t.body} mb-8`}>
          Son dos cosas distintas y conviene no mezclarlas. La protección que pueda mostrar la
          aplicación depende de las condiciones que la plataforma acuerde con su aseguradora; tu
          póliza depende de lo que tú contrataste y declaraste. Antes de asumir que una reemplaza a la
          otra, revisa ambas por escrito.
        </p>

        <div class="grid gap-8 md:grid-cols-2">
          <div>
            <h3 class={t.h3}>Dos contratos que no se sustituyen</h3>
            <p class={t.body}>
              La cobertura atada a una plataforma suele describir qué pasa durante un viaje. Tu póliza
              personal responde por el vehículo y por tu patrimonio el resto del tiempo: cuando el auto
              está estacionado, cuando lo usas para la familia o cuando un tercero te reclama daños.
              Ninguna de las dos cubre automáticamente lo que cubre la otra.
            </p>
          </div>

          <div>
            <h3 class={t.h3}>El uso declarado lo define todo</h3>
            <p class={t.body}>
              Cuando contratas, declaras para qué usarás el auto. Ese dato es parte del contrato: si
              declaras uso particular y después operas con una aplicación, la aseguradora puede
              considerar que hubo un cambio de riesgo no informado. Declararlo bien desde el inicio es
              más barato que descubrirlo en un siniestro.
            </p>
          </div>
        </div>

        <div class="mt-8">
          <h3 class={t.h3}>Qué revisar antes de contratar</h3>
          <ul class="max-w-[70ch] list-disc space-y-2 pl-5 text-[var(--text-muted)]">
            {policyChecks.map((check) => <li>{check}</li>)}
          </ul>
          <p class="mt-4 max-w-[70ch] text-sm text-[var(--text-muted)]">
            Si ya tienes póliza, tráela a la cotización: la leemos contigo y te decimos qué conviene
            ajustar antes de que la necesites.
          </p>
        </div>
      </div>
    </section>

    <!-- Educational section 2 -->
    <section class="py-12" aria-labelledby="beneficios-title">
      <div class={t.container}>
        <h2 id="beneficios-title" class={`${t.h2} mb-4`}>Beneficios reales de nuestras pólizas</h2>
        <p class={`${t.body} mb-8`}>
          Esto es lo que efectivamente entregan las pólizas que cotizamos. Sin promesas que no
          aparezcan en la carátula.
        </p>

        <div class="grid gap-6 md:grid-cols-3">
          {
            benefits.map((benefit) => (
              <div class="rounded-2xl border border-[#e2e8f0] bg-white p-6">
                <h3 class={t.h3}>{benefit.title}</h3>
                <p class="text-sm text-[var(--text-muted)]">{benefit.description}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-10">
          <h3 class={t.h3}>Qué necesitamos para evaluar tu caso</h3>
          <p class={t.body}>
            El modelo, año y versión de tu vehículo, tu código postal, el uso real que le das y si
            tienes historial de siniestros. Si además nos dices cuántos viajes haces al día y si el auto
            es tuyo o está a nombre de otra persona, la comparación entre AXA y Afirme sale más precisa.
          </p>
        </div>
      </div>
    </section>

    <!-- Price and payment -->
    <section class="bg-white py-12" aria-labelledby="costo-title">
      <div class={t.container}>
        <h2 id="costo-title" class={`${t.h2} mb-4`}>Costo y formas de pago</h2>

        <p class={`${t.body} mb-6`}>
          El costo promedio anual ronda entre los <strong>$20,000 y $30,000 MXN</strong> (varía según
          el vehículo). La cifra exacta se confirma con la cotización de la aseguradora, porque depende
          del modelo, el año, el código postal y las coberturas que elijas.
        </p>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={t.h3}>Pagos con tarjeta de crédito</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Mensual o trimestral, con cargo a tu tarjeta de crédito.
            </p>
          </div>

          <div class="rounded-2xl border border-[#e2e8f0] bg-[var(--gray-card)] p-6">
            <h3 class={t.h3}>Pago directo</h3>
            <p class="text-sm text-[var(--text-muted)]">
              Semestral o anual, pagando directamente a la aseguradora.
            </p>
          </div>
        </div>

        <p class="mt-6 max-w-[70ch] rounded-2xl border-l-4 border-[var(--red-bright)] bg-[var(--gray-bg)] p-4 text-sm text-[var(--navy)]">
          <i class="fas fa-shield-alt text-[var(--red-bright)]" aria-hidden="true"></i>
          <strong>No recibimos tu dinero:</strong> pagas directo a AXA o Afirme.
        </p>
      </div>
    </section>

    <LandingForm
      idPrefix="didi"
      subject="Cotización DiDi - AV Seguros Real"
      source="seguro-para-didi"
      whatsappHref={whatsappHref}
    />

    <LandingFAQ faqs={faqs} headingId="didi-faq-title" tone="white" />

    <LandingTestimonials />

    <!-- Closing CTA -->
    <section class="py-12" aria-labelledby="cierre-title">
      <div class={`${t.container} text-center`}>
        <h2 id="cierre-title" class={`${t.h2} mb-3`}>Cotiza con un agente real</h2>
        <p class="mx-auto mb-6 max-w-[60ch] text-[var(--text-muted)]">
          Revisamos tu caso, comparamos AXA y Afirme y te decimos con claridad qué cobertura te
          corresponde como conductor de DiDi.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="#cotizar"
            class="inline-flex items-center gap-2 rounded-full bg-[var(--red-bright)] px-7 py-3 font-bold text-white transition hover:bg-[var(--red)]"
          >
            <i class="fas fa-file-signature" aria-hidden="true"></i> Cotizar mi seguro
          </a>
          <a
            href={whatsappHref}
            class="inline-flex items-center gap-2 rounded-full border border-[var(--navy)] px-7 py-3 font-semibold text-[var(--navy)] transition hover:bg-[var(--navy)] hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
