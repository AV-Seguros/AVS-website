---
// Card used by `/blog/` and every category index, so both listings always
// render the same fields, order and styling.
import type { CollectionEntry } from 'astro:content';
import {
  blogCategoryPath,
  blogPostPath,
  formatBlogDate,
  readingTimeLabel,
} from '../../config/blog';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const href = blogPostPath(post.id);
const categoryHref = blogCategoryPath(post.data.category);
const publishedAt = post.data.publishDate.toISOString();
---

<article
  class="flex w-full flex-col rounded-2xl border border-[#e2e8f0] bg-white p-6 transition hover:-translate-y-0.5 hover:border-[var(--red-bright)] hover:shadow-[0_18px_40px_rgba(11,37,69,0.10)]"
>
  <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-bold uppercase tracking-[0.08em]">
    <a href={categoryHref} class="text-[var(--red)] hover:underline">{post.data.category}</a>
    <time
      datetime={publishedAt}
      class="font-medium normal-case tracking-normal text-[var(--text-muted)]"
    >
      {formatBlogDate(post.data.publishDate)}
    </time>
    <span class="font-medium normal-case tracking-normal text-[var(--text-muted)]">
      {readingTimeLabel(post.body)}
    </span>
  </p>

  <h2 class="mb-2 text-lg font-bold leading-snug text-[var(--navy)]">
    <a href={href} class="hover:text-[var(--red)]">{post.data.title}</a>
  </h2>

  <p class="mb-5 text-sm leading-relaxed text-[var(--text-muted)]">
    {post.data.description}
  </p>

  <a
    href={href}
    class="mt-auto inline-flex items-center gap-2 text-sm font-bold text-[var(--red)] hover:underline"
  >
    Leer artículo
    <i class="fas fa-arrow-right text-[0.7rem]" aria-hidden="true"></i>
  </a>
</article>
