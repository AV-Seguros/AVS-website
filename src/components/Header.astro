---
// Site header: brand link, main navigation, primary CTA and mobile menu.
import logo from '../../public/logo.png';
import { mainNavigation, isCurrentPath } from '../config/navigation';
import { siteConfig } from '../config/site';

const whatsappMessage = '¡Hola! Quiero cotizar mi seguro de auto con un agente real.';
const whatsappUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const phoneUrl = `tel:+${siteConfig.whatsappNumber}`;
---

<header class="header">
  <div class="header__inner">
    <div class="header__logo">
      <a class="header__logo-link" href="/">
        <img src={logo.src} alt="logo-avsr" title="Logo AV Seguros Real" class="logo" />
        <span class="header__brand">
          AV · <span class="header__brand-sub">Seguros Real</span>
        </span>
      </a>
    </div>

    <button
      class="header__hamburger"
      id="hamburgerBtn"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <nav class="header__nav" id="navLinks" aria-label="Navegación principal">
      {
        mainNavigation.map((link) => (
          <a
            href={link.href}
            class="header__link"
            aria-current={isCurrentPath(link.href, Astro.url.pathname) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={whatsappUrl}
        class="header__link header__cta header__cta--desktop"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
      </a>
      <a href={phoneUrl} class="header__link header__cta header__cta--mobile">
        <i class="fas fa-phone" aria-hidden="true"></i> Llamar ahora
      </a>
    </nav>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburgerBtn');
  const navLinks = document.getElementById('navLinks');

  const setMenuOpen = (open: boolean) => {
    hamburger?.setAttribute('aria-expanded', String(open));
    navLinks?.classList.toggle('open', open);
  };

  const isMenuOpen = () => hamburger?.getAttribute('aria-expanded') === 'true';

  hamburger?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen()) {
      setMenuOpen(false);
      hamburger?.focus();
    }
  });

  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>

<style lang="scss">
  .header {
    background: var(--navy);
    color: white;
    padding: 0.8rem 0;
    border-bottom: 4px solid var(--red-bright);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);

    &__inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    &__logo {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    &__logo-link {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      color: inherit;

      .logo {
        width: 50px;
        background-color: #fff;
        border-radius: 15px;
      }
    }

    &__brand {
      display: flex;
      align-items: center;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    &__brand-sub {
      font-weight: 400;
      color: #b0c4de;
      font-size: 0.9rem;
      margin-left: 0.3rem;
    }

    &__nav {
      display: flex;
      gap: 2rem;
      align-items: center;
      flex-wrap: wrap;
    }

    &__link {
      color: #e2e8f0;
      font-weight: 500;
      font-size: 0.95rem;
      transition: 0.2s;
      border-bottom: 2px solid transparent;
      padding-bottom: 0.2rem;

      &:hover {
        color: white;
        border-bottom-color: var(--red-bright);
      }

      &[aria-current='page'] {
        color: white;
        border-bottom-color: var(--red-bright);
      }
    }

    &__cta {
      background: var(--red-bright);
      padding: 0.5rem 1.2rem;
      border-radius: 40px;
      font-weight: 600;
      color: white !important;
      border: none !important;

      &:hover {
        background: #b71c1c;
        transform: scale(1.02);
      }
    }

    // Desktop por defecto: desktop visible, mobile oculto
    &__cta--mobile {
      display: none;
    }

    &__hamburger {
      display: none;
      font-size: 1.6rem;
      color: white;
      cursor: pointer;
      background: none;
      border: none;
    }

    @media (max-width: 780px) {
      &__nav {
        display: none;
        width: 100%;
        flex-direction: column;
        gap: 0.8rem;
        padding: 1rem 0 0.5rem;

        &.open {
          display: flex;
        }
      }

      &__hamburger {
        display: block;
      }

      &__inner {
        flex-wrap: wrap;
      }

      // En móvil: desktop oculto, mobile visible
      &__cta--desktop {
        display: none;
      }

      &__cta--mobile {
        display: inline;
      }
    }
  }
</style>
