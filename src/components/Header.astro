---
// Site header: brand link, main navigation (with the services mega menu),
// primary CTA and mobile menu.
import logo from '../../public/logo.png';
import { mainNavigation, menuGroups, isCurrentPath, isCurrentSection } from '../config/navigation';
import { siteConfig } from '../config/site';
import { buildWhatsAppUrl } from '../scripts/whatsapp';

const whatsappUrl = buildWhatsAppUrl('cotizacion-auto');
const phoneUrl = `tel:+${siteConfig.whatsappNumber}`;

const pathname = Astro.url.pathname;
const allMenuLinks = menuGroups.flatMap((group) => group.links);
const servicesActive = isCurrentSection(allMenuLinks, pathname);
---

<header class="header">
  <div class="header__inner">
    <div class="header__logo">
      <a class="header__logo-link" href="/">
        <img src={logo.src} alt="logo-avsr" title="Logo AV Seguros Real" class="logo" />
        <span class="header__brand">
          AV · <span class="header__brand-sub">Seguros Real</span>
        </span>
      </a>
    </div>

    <button
      class="header__hamburger"
      id="hamburgerBtn"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <nav class="header__nav" id="navLinks" aria-label="Navegación principal">
      {
        mainNavigation.map((link) =>
          link.menu === 'services' ? (
            <div class="header__item header__item--menu" data-nav-item>
              <button
                type="button"
                class:list={['header__link', 'header__trigger', { 'header__link--active': servicesActive }]}
                id="servicesTrigger"
                data-nav-trigger
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="servicesMenu"
              >
                {link.label}
                <i class="fas fa-chevron-down header__chevron" aria-hidden="true" />
              </button>

              <div class="header__panel" id="servicesMenu" data-nav-panel hidden>
                <div class="grid gap-5 p-4 md:gap-6 md:p-6 min-[1150px]:grid-cols-4">
                  {
                    menuGroups.map((group) => (
                      <div>
                        <p class="text-[0.72rem] font-bold uppercase tracking-[0.08em] text-[var(--red)]">
                          {group.label}
                        </p>
                        <p class="mt-1 mb-2 text-sm leading-snug text-[var(--text-muted)]">
                          {group.description}
                        </p>
                        <ul>
                          {group.links.map((item) => (
                            <li>
                              <a
                                href={item.href}
                                class="flex items-center justify-between gap-2 rounded-lg px-2 py-2 text-[0.95rem] font-medium text-[var(--navy)] transition hover:bg-[var(--gray-card)] hover:text-[var(--red)]"
                                aria-current={
                                  isCurrentPath(item.href, pathname) ? 'page' : undefined
                                }
                              >
                                {item.label}
                                <i class="fas fa-arrow-right text-[0.65rem]" aria-hidden="true" />
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))
                  }

                  <div class="hidden rounded-xl bg-[var(--navy)] p-5 text-white min-[1150px]:col-span-4 min-[1150px]:block">
                    <div class="flex flex-col gap-4 min-[1150px]:flex-row min-[1150px]:items-center min-[1150px]:justify-between">
                      <div>
                        <p class="text-[0.72rem] font-bold uppercase tracking-[0.08em] text-[#b0c4de]">
                          Asesoría personal
                        </p>
                        <p class="mt-1 text-[1.05rem] font-semibold leading-snug">
                          ¿No sabes cuál te conviene?
                        </p>
                        <p class="mt-1 text-sm text-[#c9d6e6]">
                          Cuéntanos tu caso y te ayudamos a comparar opciones.
                        </p>
                      </div>
                      <div class="flex flex-wrap items-center gap-4 min-[1150px]:shrink-0">
                        <a
                          href={whatsappUrl}
                          class="inline-flex items-center gap-2 rounded-full bg-[var(--red-bright)] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[var(--red)]"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <i class="fab fa-whatsapp" aria-hidden="true" /> Escríbenos
                        </a>
                        <a
                          href="/contacto/"
                          class="text-sm font-medium text-white underline decoration-[#b0c4de] underline-offset-4 transition hover:decoration-white"
                        >
                          Ver todos los servicios
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="header__link"
              aria-current={isCurrentPath(link.href, pathname) ? 'page' : undefined}
            >
              {link.label}
            </a>
          )
        )
      }
      <a
        href={whatsappUrl}
        class="header__link header__cta header__cta--desktop"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp
      </a>
      <a href={phoneUrl} class="header__link header__cta header__cta--mobile">
        <i class="fas fa-phone" aria-hidden="true"></i> Llamar ahora
      </a>
    </nav>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburgerBtn');
  const navLinks = document.getElementById('navLinks');

  const navItem = document.querySelector<HTMLElement>('[data-nav-item]');
  const navTrigger = navItem?.querySelector<HTMLButtonElement>('[data-nav-trigger]');
  const navPanel = navItem?.querySelector<HTMLElement>('[data-nav-panel]');

  const setMenuOpen = (open: boolean) => {
    hamburger?.setAttribute('aria-expanded', String(open));
    navLinks?.classList.toggle('open', open);
  };

  const isMenuOpen = () => hamburger?.getAttribute('aria-expanded') === 'true';

  // The mega menu is a disclosure panel: the trigger owns `aria-expanded` and
  // `aria-controls` on both desktop and mobile, so click, Enter and Space work
  // everywhere and hover only adds a shortcut on desktop.
  const setServicesOpen = (open: boolean) => {
    if (!navTrigger || !navPanel) return;
    navTrigger.setAttribute('aria-expanded', String(open));
    navPanel.hidden = !open;
  };

  const isServicesOpen = () => navTrigger?.getAttribute('aria-expanded') === 'true';

  const desktopQuery = window.matchMedia('(min-width: 1150px)');

  // The panel floats a few pixels below the trigger, so a pointer walking from
  // the trigger to the panel crosses an area that is no longer inside the
  // trigger. Closing immediately there made the menu vanish mid-travel; a short
  // grace period closes it only when the pointer really left. Everything else
  // (hover, click, focus) feeds this one open/closed state, so the trigger can
  // never fight itself.
  const HOVER_CLOSE_DELAY = 220;

  let closeTimer: ReturnType<typeof setTimeout> | undefined;
  let pinned = false;
  let pointerInside = false;
  // Set when Escape closes the panel: the focus that Escape sends back to the
  // trigger must not reopen it. Cleared as soon as the user moves or clicks.
  let dismissed = false;

  const clearCloseTimer = () => {
    if (closeTimer !== undefined) clearTimeout(closeTimer);
    closeTimer = undefined;
  };

  const openServices = () => {
    clearCloseTimer();
    dismissed = false;
    setServicesOpen(true);
  };

  const closeServices = () => {
    clearCloseTimer();
    pinned = false;
    setServicesOpen(false);
  };

  const scheduleServicesClose = () => {
    clearCloseTimer();
    closeTimer = setTimeout(() => {
      closeTimer = undefined;
      if (pinned || pointerInside) return;
      if (navItem?.contains(document.activeElement)) return;
      setServicesOpen(false);
    }, HOVER_CLOSE_DELAY);
  };

  hamburger?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));

  navTrigger?.addEventListener('click', () => {
    if (isServicesOpen() && pinned) {
      closeServices();
      return;
    }

    pinned = true;
    openServices();
  });

  navItem?.addEventListener('mouseenter', () => {
    pointerInside = true;
    dismissed = false;
    clearCloseTimer();
    if (desktopQuery.matches) openServices();
  });

  navItem?.addEventListener('mouseleave', () => {
    pointerInside = false;
    if (desktopQuery.matches && !pinned) scheduleServicesClose();
  });

  // Keyboard users get the same panel by focusing the trigger or tabbing
  // through it; it closes again once focus leaves the item entirely.
  navItem?.addEventListener('focusin', () => {
    if (dismissed) return;
    openServices();
  });

  navItem?.addEventListener('focusout', (event) => {
    const next = event.relatedTarget;
    if (next instanceof Node && navItem.contains(next)) return;

    dismissed = false;

    if (pinned || (desktopQuery.matches && pointerInside)) return;
    scheduleServicesClose();
  });

  document.addEventListener('click', (event) => {
    if (!isServicesOpen() || !navItem) return;
    if (!navItem.contains(event.target as Node)) closeServices();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    if (isServicesOpen()) {
      closeServices();
      dismissed = true;
      navTrigger?.focus();
      return;
    }

    if (isMenuOpen()) {
      setMenuOpen(false);
      hamburger?.focus();
    }
  });

  desktopQuery.addEventListener('change', () => {
    closeServices();
    setMenuOpen(false);
  });

  // Navigating away from the header closes the mobile menu, including any
  // link inside the services panel.
  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      setMenuOpen(false);
      closeServices();
    });
  });
</script>

<style lang="scss">
  .header {
    background: var(--navy);
    color: white;
    padding: 0.8rem 0;
    border-bottom: 4px solid var(--red-bright);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);

    &__inner {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    &__logo {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    &__logo-link {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      color: inherit;

      .logo {
        width: 50px;
        background-color: #fff;
        border-radius: 15px;
      }
    }

    &__brand {
      display: flex;
      align-items: center;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    &__brand-sub {
      font-weight: 400;
      color: #b0c4de;
      font-size: 0.9rem;
      margin-left: 0.3rem;
    }

    &__nav {
      display: flex;
      // Seven entries plus the CTA need the whole 1200px bar, so the gap is
      // tight on purpose; below 1150px the nav hands over to the hamburger.
      gap: 0.85rem;
      align-items: center;
      flex-wrap: wrap;
    }

    &__link {
      color: #e2e8f0;
      font-weight: 500;
      font-size: 0.95rem;
      transition: 0.2s;
      border-bottom: 2px solid transparent;
      padding-bottom: 0.2rem;

      &:hover {
        color: white;
        border-bottom-color: var(--red-bright);
      }

      &:focus-visible {
        color: white;
        outline: 2px solid white;
        outline-offset: 4px;
        border-radius: 2px;
      }

      &[aria-current='page'],
      &--active {
        color: white;
        border-bottom-color: var(--red-bright);
      }
    }

    // Services trigger: a button that looks like the sibling links.
    &__item--menu {
      display: flex;
      align-items: center;
    }

    &__trigger {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      font: inherit;
      font-weight: 500;
      font-size: 0.95rem;
      line-height: inherit;
      cursor: pointer;

      .header__chevron {
        font-size: 0.6rem;
        transition: transform 0.2s;
      }

      &[aria-expanded='true'] .header__chevron {
        transform: rotate(180deg);
      }
    }

    &__panel {
      display: none;

      // The `hidden` attribute is the single source of visibility: the media
      // queries below only decide *how* a visible panel is laid out.
      &[hidden] {
        display: none;
      }
    }

    &__cta {
      background: var(--red-bright);
      padding: 0.5rem 1.2rem;
      border-radius: 40px;
      font-weight: 600;
      color: white !important;
      border: none !important;

      &:hover {
        background: #b71c1c;
        transform: scale(1.02);
      }
    }

    // Desktop por defecto: desktop visible, mobile oculto
    &__cta--mobile {
      display: none;
    }

    &__hamburger {
      display: none;
      font-size: 1.6rem;
      color: white;
      cursor: pointer;
      background: none;
      border: none;
    }

    @media (min-width: 1150px) {
      &__panel {
        display: block;
        position: absolute;
        top: calc(100% + 1.2rem);
        left: 0;
        right: 0;
        z-index: 60;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 24px 60px rgba(11, 37, 69, 0.18);
      }
    }

    @media (max-width: 1149px) {
      &__nav {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0.8rem;
        padding: 1rem 0 0.5rem;
        max-height: calc(100vh - 6rem);
        overflow-y: auto;

        &.open {
          display: flex;
        }
      }

      &__item--menu {
        flex-direction: column;
        align-items: stretch;
      }

      &__trigger {
        justify-content: space-between;
        padding: 0.2rem 0;
      }

      &__panel {
        display: block;
        width: 100%;
        margin-top: 0.4rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.9rem;
        background: white;
        overflow: hidden;
      }

      &__hamburger {
        display: block;
      }

      &__inner {
        flex-wrap: wrap;
      }

      // En móvil: desktop oculto, mobile visible
      &__cta--desktop {
        display: none;
      }

      &__cta--mobile {
        display: inline;
        text-align: center;
      }
    }
  }
</style>
