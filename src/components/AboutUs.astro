---
// Sección "Quiénes somos" con grid de 2 columnas
const items = [
  { icon: 'fas fa-handshake', title: 'Trato directo', desc: 'Sin intermediarios, sin bots. Hablas conmigo, resuelvo tus dudas y te doy seguimiento personalizado.' },
  { icon: 'fas fa-award', title: 'Las mejores aseguradoras', desc: 'Trabajamos con <strong>AXA</strong> y <strong>Afirme</strong>, dos de las compañías con mayor solidez y respaldo en México.' },
  { icon: 'fas fa-user-check', title: 'Compromiso de confianza', desc: 'Acuerdo de palabra entre amigos, pero con la seriedad de un profesional. Tu tranquilidad es mi prioridad.' },
  { icon: 'fas fa-car-crash', title: 'Daños a terceros', desc: 'Cubre los daños ocasionados por un accidente a terceros, es decir, a otros automóviles, mobiliario urbano e incluso personas.' },
];
---

<section id="quienes" class="quienes">
  <div class="quienes__container">
    <div class="quienes__header">
      <h2 class="quienes__title">¿Quiénes somos?</h2>
      <p class="quienes__sub">
        No somos una aseguradora, somos tu aliado. Una persona real que te acompaña en cada paso.
      </p>
    </div>
    <div class="quienes__grid">
      {items.map((item) => (
        <div class="quienes__card">
          <i class={item.icon} aria-hidden="true"></i>
          <h4>{item.title}</h4>
          <p set:html={item.desc} />
        </div>
      ))}
    </div>
    <div class="quienes__cta">
      <a href="#contacto" class="quienes__cta-btn">
        <i class="fas fa-paper-plane" aria-hidden="true"></i> Contáctanos ahora
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .quienes {
    background: white;

    &__container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3.5rem 1.8rem;
    }

    &__header {
      text-align: center;
    }

    &__title {
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 0.5rem;
      letter-spacing: -0.02em;
    }

    &__sub {
      color: var(--text-muted);
      font-size: 1.05rem;
      max-width: 700px;
      margin: 0 auto;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.8rem;
      margin-top: 2rem;
    }

    &__card {
      background: var(--gray-card);
      padding: 1.8rem 1.8rem 2rem;
      border-radius: 1.5rem;
      border-left: 6px solid var(--red-bright);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
      transition: 0.25s;

      &:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
      }

      i {
        font-size: 2rem;
        color: var(--red-bright);
        background: rgba(230, 57, 70, 0.06);
        padding: 0.5rem;
        border-radius: 16px;
        margin-bottom: 0.8rem;
        display: inline-block;
      }

      h4 {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 0.4rem;
      }

      p {
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
      }
    }

    &__cta {
      text-align: center;
      margin-top: 2.5rem;
    }

    &__cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--red-bright);
      color: white;
      padding: 1rem 2.5rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 1.05rem;
      text-decoration: none;
      transition: 0.25s;
      box-shadow: 0 6px 18px rgba(201, 42, 42, 0.3);
      letter-spacing: 0.3px;

      i {
        font-size: 1rem;
        transition: transform 0.25s;
      }

      &:hover {
        background: #b71c1c;
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(201, 42, 42, 0.35);

        i {
          transform: translateX(3px);
        }
      }
    }

    @media (max-width: 640px) {
      &__grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 540px) {
      &__container {
        padding: 2.5rem 1.2rem;
      }

      &__title {
        font-size: 1.7rem;
      }

      &__sub {
        font-size: 0.95rem;
      }

      &__card {
        padding: 1.4rem 1.2rem 1.6rem;
        border-radius: 1.2rem;

        i {
          font-size: 1.6rem;
        }

        h4 {
          font-size: 1.1rem;
        }

        p {
          font-size: 0.9rem;
        }
      }
    }
  }
</style>
