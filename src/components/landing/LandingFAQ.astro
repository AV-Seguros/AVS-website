---
// Shared FAQ block for the landing pages. The visible accordions and the
// `FAQPage` JSON-LD are generated from the same array, so copy and schema
// cannot drift.
import { landingTokens } from './tokens';

export interface FAQ {
  question: string;
  answer: string;
  /** Optional deepen link, used when another page explains the topic in full. */
  link?: { label: string; href: string };
}

export interface Props {
  faqs: FAQ[];
  /** id of the section heading, used as the accessible name of the section. */
  headingId: string;
  /** Section heading. Category sections on `/faq/` override the default. */
  heading?: string;
  /** `white` paints the section background, `muted` keeps the page background. */
  tone?: 'white' | 'muted';
  /**
   * Emit the `FAQPage` JSON-LD block. Set to false when the page builds one
   * node from every category, so the page never ships several FAQPage nodes.
   */
  withSchema?: boolean;
}

const { faqs, headingId, heading = 'Preguntas frecuentes', tone = 'muted', withSchema = true } =
  Astro.props;

const sectionClass = tone === 'white' ? 'bg-white py-12' : 'py-12';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<section class={sectionClass} aria-labelledby={headingId}>
  <div class={landingTokens.container}>
    <h2 id={headingId} class={`${landingTokens.h2} mb-6`}>{heading}</h2>

    <div class="mx-auto max-w-[820px] space-y-3">
      {
        faqs.map((faq) => (
          <details class="rounded-xl border-l-4 border-[var(--red-bright)] bg-[var(--gray-card)] p-5">
            <summary class="cursor-pointer font-bold text-[var(--navy)]">{faq.question}</summary>
            <p class="mt-3 text-[var(--text-muted)]">{faq.answer}</p>
            {
              faq.link && (
                <a
                  href={faq.link.href}
                  class="mt-2 inline-block text-sm font-semibold text-[var(--red)] hover:underline"
                >
                  {faq.link.label}
                </a>
              )
            }
          </details>
        ))
      }
    </div>
  </div>
</section>

{withSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
