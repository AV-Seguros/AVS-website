---
// Shared quotation form for the landing pages: three fields, privacy consent,
// client-side validation and a plain POST to the temporary form backend.
import { landingTokens } from './tokens';

export interface Props {
  /** Namespaces every element id, e.g. "auto" → "auto-nombre". */
  idPrefix: string;
  /** Email subject of the lead. */
  subject: string;
  /** Page identifier sent along with the lead. */
  source: string;
  whatsappHref: string;
  /** `white` paints the section background, `muted` keeps the page background. */
  tone?: 'white' | 'muted';
  heading?: string;
  description?: string;
}

const {
  idPrefix,
  subject,
  source,
  whatsappHref,
  tone = 'muted',
  heading = 'Solicita tu cotización',
  description = 'Tres datos y un agente real te contacta en 24h o menos para revisar tu caso.',
} = Astro.props;

// Temporary submission target: the form backend is decided in `1.6.1`
// (ROADMAP §8). This reuses the Formspree endpoint already configured for the
// other site forms. It is intentionally not advertised in the visible copy.
const FORM_ENDPOINT = 'https://formspree.io/f/mgaekvbe';

const sectionClass = tone === 'white' ? 'bg-white py-12' : 'py-12';
const formId = `${idPrefix}LeadForm`;
const submitId = `${idPrefix}SubmitBtn`;
const nameId = `${idPrefix}-nombre`;
const phoneId = `${idPrefix}-whatsapp`;
const emailId = `${idPrefix}-email`;
const consentId = `${idPrefix}-consent`;
const formErrorId = `${idPrefix}-form-error`;
---

<section id="cotizar" class={sectionClass} aria-labelledby="cotizar-title">
  <div class={landingTokens.container}>
    <div class="mx-auto max-w-[640px]">
      <h2 id="cotizar-title" class={`${landingTokens.h2} mb-3`}>{heading}</h2>
      <p class={`${landingTokens.body} mb-6`}>{description}</p>

      <form
        id={formId}
        data-landing-form={idPrefix}
        class="rounded-2xl border border-[#e2e8f0] bg-white p-6 md:p-8"
        action={FORM_ENDPOINT}
        method="POST"
        novalidate
      >
        <input type="hidden" name="_subject" value={subject} />
        <input type="hidden" name="_source" value={source} />

        <div class="mb-4">
          <label for={nameId} class="mb-1 block text-sm font-semibold text-[var(--navy)]">
            Nombre *
          </label>
          <input
            type="text"
            id={nameId}
            name="Nombre"
            autocomplete="name"
            class={landingTokens.input}
            aria-describedby={`${nameId}-error`}
            required
          />
          <p id={`${nameId}-error`} class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
            Escribe tu nombre.
          </p>
        </div>

        <div class="mb-4">
          <label for={phoneId} class="mb-1 block text-sm font-semibold text-[var(--navy)]">
            WhatsApp *
          </label>
          <input
            type="tel"
            id={phoneId}
            name="WhatsApp"
            inputmode="tel"
            autocomplete="tel"
            placeholder="81 1234 5678"
            class={landingTokens.input}
            aria-describedby={`${phoneId}-error`}
            required
          />
          <p id={`${phoneId}-error`} class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
            Escribe un número de WhatsApp de al menos 10 dígitos.
          </p>
        </div>

        <div class="mb-4">
          <label for={emailId} class="mb-1 block text-sm font-semibold text-[var(--navy)]">
            Correo electrónico *
          </label>
          <input
            type="email"
            id={emailId}
            name="Email"
            autocomplete="email"
            class={landingTokens.input}
            aria-describedby={`${emailId}-error`}
            required
          />
          <p id={`${emailId}-error`} class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
            Escribe un correo electrónico válido.
          </p>
        </div>

        <div class="mb-6">
          <label for={consentId} class="flex items-start gap-3 text-sm text-[var(--text-muted)]">
            <input
              type="checkbox"
              id={consentId}
              name="Consentimiento"
              value="Aceptado"
              class="mt-1 h-4 w-4"
              aria-describedby={`${consentId}-error`}
              required
            />
            <span>
              Acepto el
              <a href="/aviso-de-privacidad/" class="font-semibold text-[var(--red)] underline">
                aviso de privacidad</a
              >
              y el contacto por WhatsApp o correo para recibir mi cotización.
            </span>
          </label>
          <p id={`${consentId}-error`} class="mt-1 hidden text-sm text-[var(--red)]" role="alert">
            Necesitamos tu consentimiento para contactarte.
          </p>
        </div>

        <button
          type="submit"
          id={submitId}
          class="w-full rounded-full bg-[var(--red-bright)] px-6 py-3 font-bold text-white transition hover:bg-[var(--red)]"
        >
          <i class="fas fa-paper-plane" aria-hidden="true"></i> Enviar solicitud
        </button>

        <p id={formErrorId} class="mt-4 hidden text-sm text-[var(--red)]" role="alert">
          No pudimos enviar tu solicitud.
          <a href={whatsappHref} class="font-bold underline" target="_blank" rel="noopener noreferrer">
            Escríbenos por WhatsApp</a
          >
          y lo vemos de inmediato.
        </p>

        <p class="mt-4 text-xs text-[var(--text-muted)]">
          Tus datos se usan solo para contactarte sobre esta cotización.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-landing-form]');

    const isPhoneValid = (value: string) => value.replace(/\D/g, '').length >= 10;
    const isEmailValid = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value.trim());

    forms.forEach((form) => {
      const prefix = form.dataset.landingForm;
      if (!prefix) return;

      const btn = document.getElementById(`${prefix}SubmitBtn`) as HTMLButtonElement | null;
      if (!btn) return;

      const formError = document.getElementById(`${prefix}-form-error`);
      const nameInput = document.getElementById(`${prefix}-nombre`) as HTMLInputElement;
      const phoneInput = document.getElementById(`${prefix}-whatsapp`) as HTMLInputElement;
      const emailInput = document.getElementById(`${prefix}-email`) as HTMLInputElement;
      const consentInput = document.getElementById(`${prefix}-consent`) as HTMLInputElement;

      const setFieldError = (input: HTMLInputElement, errorId: string, hasError: boolean) => {
        const error = document.getElementById(errorId);
        error?.classList.toggle('hidden', !hasError);
        input.setAttribute('aria-invalid', String(hasError));
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        formError?.classList.add('hidden');

        const hasName = nameInput.value.trim().length >= 2;
        const hasPhone = isPhoneValid(phoneInput.value);
        const hasEmail = isEmailValid(emailInput.value);
        const hasConsent = consentInput.checked;

        setFieldError(nameInput, `${prefix}-nombre-error`, !hasName);
        setFieldError(phoneInput, `${prefix}-whatsapp-error`, !hasPhone);
        setFieldError(emailInput, `${prefix}-email-error`, !hasEmail);
        setFieldError(consentInput, `${prefix}-consent-error`, !hasConsent);

        const fields = [nameInput, phoneInput, emailInput, consentInput];
        const firstInvalid = [!hasName, !hasPhone, !hasEmail, !hasConsent].indexOf(true);
        if (firstInvalid !== -1) {
          fields[firstInvalid].focus();
          return;
        }

        const originalLabel = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Enviando...';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (!response.ok) throw new Error('Submission failed');

          window.location.href = `${import.meta.env.BASE_URL}gracias`;
        } catch {
          formError?.classList.remove('hidden');
          btn.disabled = false;
          btn.innerHTML = originalLabel;
        }
      });
    });
  })();
</script>
