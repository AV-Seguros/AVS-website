---
// Hero section con formulario de cotización inline
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero__container">
    <div class="hero__left">
      <h2 id="hero-title" class="hero__title">
        Seguro de auto <br />
        <span class="hero__highlight">con persona real</span> al otro lado
      </h2>
      <p class="hero__desc">
        Olvídate de robots y comparadores fríos. Cotización <strong>100% manual</strong>, hecha
        por un agente físico.<br />
        <strong>AXA · Afirme</strong>, cobertura nacional.
      </p>

      <div class="hero__badges">
        <span class="hero__badge">
          <i class="fas fa-check-circle" aria-hidden="true"></i> Atención personal
        </span>
        <span class="hero__badge">
          <i class="fas fa-phone-alt" aria-hidden="true"></i> Seguimiento real
        </span>
        <span class="hero__badge">
          <i class="fas fa-sync-alt" aria-hidden="true"></i> Renovación anual
        </span>
        <span class="hero__badge">
          <i class="fas fa-tag" aria-hidden="true"></i> 20% descuento
        </span>
      </div>

      <div class="hero__logos">
        <span class="hero__logo-badge">
          <img src={`${import.meta.env.BASE_URL}logo-axa.webp`} alt="Logo AXA" class="hero__logo-img" />
        </span>
        <span class="hero__logo-badge">
          <img src={`${import.meta.env.BASE_URL}logo-afirme.jpg`} alt="Logo Afirme" class="hero__logo-img" />
        </span>
        <br /><br />
        <span class="hero__logo-badge hero__logo-badge--transparent">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Cobertura en todo México
        </span>
      </div>
    </div>

    <!-- Formulario en HERO -->
    <div class="hero__form" role="form" aria-label="Formulario de cotización">
      <h3 class="hero__form-title">
        <i class="fas fa-file-signature" aria-hidden="true"></i> Solicita tu cotización
      </h3>
      <p class="hero__form-sub">
        Rellena el formulario y un agente real te contactará en <strong>24h o menos</strong>.
      </p>
      <form id="leadFormHero" action="https://formspree.io/f/mgaekvbe" method="POST">
        <input type="hidden" name="_subject" value="Nueva cotización desde Hero - AVReal" />
        <input type="hidden" name="_source" value="hero" />
        <div class="hero__form-row">
          <div class="hero__form-group">
            <label for="hero-nombre">
              <i class="fas fa-user" aria-hidden="true"></i> Nombre *
            </label>
            <input type="text" id="hero-nombre" name="Nombre" placeholder="Ej. Carlos Martínez" required aria-required="true" />
          </div>
          <div class="hero__form-group">
            <label for="hero-telefono">
              <i class="fas fa-phone" aria-hidden="true"></i> Teléfono *
            </label>
            <input type="tel" id="hero-telefono" name="Telefono" placeholder="81 2013 0995" required aria-required="true" />
          </div>
        </div>
        <div class="hero__form-row">
          <div class="hero__form-group">
            <label for="hero-email">
              <i class="fas fa-envelope" aria-hidden="true"></i> Correo *
            </label>
            <input type="email" id="hero-email" name="Email" placeholder="carlos@email.com" required aria-required="true" />
          </div>
          <div class="hero__form-group">
            <label for="hero-cp">
              <i class="fas fa-map-pin" aria-hidden="true"></i> C.P.
            </label>
            <input type="text" id="hero-cp" name="CP" placeholder="06100" maxlength="5" />
          </div>
        </div>
        <div class="hero__form-group">
          <label for="hero-aseguradora">
            <i class="fas fa-building" aria-hidden="true"></i> Aseguradora preferida
          </label>
          <select id="hero-aseguradora" name="Aseguradora">
            <option value="AXA">AXA</option>
            <option value="Afirme">Afirme</option>
            <option value="Indistinto">Indistinto</option>
          </select>
        </div>
        <div class="hero__form-group">
          <label for="hero-comentarios">Comentarios (opcional)</label>
          <input type="text" id="hero-comentarios" name="Comentarios" placeholder="Modelo, año, cobertura deseada..." />
        </div>
        <button type="submit" class="hero__btn-submit" id="heroSubmitBtn">
          <i class="fas fa-paper-plane" aria-hidden="true"></i> Enviar · cotización manual
        </button>
        <p class="hero__legal">
          <i class="fas fa-lock" aria-hidden="true"></i> Tus datos son seguros. Sin spam, solo contacto humano.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('leadFormHero') as HTMLFormElement | null;
    const btn = document.getElementById('heroSubmitBtn') as HTMLButtonElement | null;
    if (!form || !btn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const nombre = data.get('Nombre') as string;
      const telefono = data.get('Telefono') as string;
      const email = data.get('Email') as string;
      const cp = data.get('CP') as string;

      if (!nombre || !telefono || !email || !cp) {
        alert('⚠️ Por favor, completa todos los campos obligatorios.');
        return;
      }
      if (telefono.length < 8 || !email.includes('@')) {
        alert('📱 Verifica tu teléfono y correo electrónico.');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Enviando...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          window.location.href = `${import.meta.env.BASE_URL}gracias`;
        } else {
          const result = await response.json();
          throw new Error(result.error || 'Error al enviar');
        }
      } catch (err) {
        alert('❌ Hubo un error al enviar. Intenta de nuevo.');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane" aria-hidden="true"></i> Enviar · cotización manual';
      }
    });
  })();
</script>

<style lang="scss">
  .hero {
    background: linear-gradient(145deg, #f8fafc 0%, #e9edf2 100%);
    padding: 3.5rem 0 4rem;
    border-bottom: 1px solid #dce1e8;

    &__container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.8rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    &__title {
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.15;
      color: var(--navy);
    }

    &__highlight {
      color: var(--red-bright);
      background: rgba(230, 57, 70, 0.08);
      padding: 0 0.2rem;
    }

    &__desc {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin: 1.2rem 0 2rem;
      max-width: 90%;
    }

    &__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-top: 1.8rem;
    }

    &__badge {
      background: white;
      padding: 0.4rem 1.2rem;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.85rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      border: 1px solid #dce2ec;

      i {
        color: var(--red-bright);
        margin-right: 0.4rem;
      }
    }

    &__logos {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }

    &__logo-img {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    &__logo-badge {
      background: white;
      padding: 0.3rem 1.2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 1.1rem;
      border: 1px solid #dce2ec;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
      display: inline-flex;
      align-items: center;

      i {
        color: var(--red-bright);
        margin-right: 0.5rem;
      }

      &--transparent {
        background: transparent;
        border-color: transparent;
        box-shadow: none;
        margin-top: 1rem;
      }
    }

    // ---------- Formulario ----------
    &__form {
      background: var(--navy);
      border-radius: 2rem;
      padding: 2rem 1.8rem;
      color: white;
      box-shadow: 0 20px 40px rgba(11, 37, 69, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    &__form-title {
      font-size: 1.6rem;
      font-weight: 600;

      i {
        color: var(--red-bright);
        background: rgba(255, 255, 255, 0.05);
        padding: 0.5rem;
        border-radius: 20px;
        margin-right: 0.5rem;
      }
    }

    &__form-sub {
      color: #fff;
      font-size: 0.95rem;
      margin-top: 0.5rem;
      margin-bottom: 1.2rem;
    }

    &__form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    &__form-group {
      margin-bottom: 1.2rem;

      label {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--red-bright);
        margin-bottom: 0.2rem;

        i {
          margin-right: 0.3rem;
        }
      }

      input,
      select {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 60px;
        border: 1px solid #d1d9e6;
        font-size: 0.95rem;
        background: white;
        transition: 0.2s;
        font-family: 'Inter', sans-serif;
        color: #1e293b;

        &:focus {
          border-color: var(--red-bright);
          outline: none;
          box-shadow: 0 0 0 3px rgba(230, 57, 70, 0.15);
        }
      }
    }

    &__btn-submit {
      background: var(--red-bright);
      color: white;
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 60px;
      font-weight: 700;
      font-size: 1.1rem;
      width: 100%;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 6px 14px rgba(201, 42, 42, 0.25);
      letter-spacing: 0.3px;

      &:hover {
        background: #b71c1c;
        transform: scale(1.01);
      }
    }

    &__legal {
      font-size: 0.7rem;
      color: #94a3b8;
      text-align: center;
      margin-top: 1rem;
    }

    // ---------- Responsive ----------
    @media (max-width: 780px) {
      &__container {
        grid-template-columns: 1fr;
      }

      &__title {
        font-size: 2.2rem;
      }
    }

    @media (max-width: 540px) {
      &__form-row {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
