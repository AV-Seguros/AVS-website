---
import imageHero from "../assets/hero-section.webp";
import imageHeroMobile from "../assets/hero-section-mobile.webp";
import LeadForm from "./forms/LeadForm.astro";
---

<section id="hero" class="hero relative overflow-hidden" aria-labelledby="hero-title">
  {/*
    The hero background is the LCP element: served as WebP (1920 px on desktop,
    960 px below 768 px), eager, high priority, and with explicit dimensions so
    the box is reserved before the file arrives.
  */}
  <picture class="absolute left-0 right-0 bottom-0 top-0 w-full -z-1!">
    <source media="(min-width: 1024px)" srcset={imageHero.src}>
    <source media="(min-width: 768px)" srcset={imageHero.src}>
    <img
      src={imageHeroMobile.src}
      alt="Asesor del seguro en tiempo real"
      width={imageHeroMobile.width}
      height={imageHeroMobile.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  </picture>
  <div class="hero__container">
    <div class="hero__left">
      <h1 id="hero-title" class="hero__title">
        Seguro de auto en México <br />
        <span class="hero__highlight">con asesoría personal</span>
      </h1>
      <p class="hero__desc">
        Olvídate de robots y comparadores fríos. Cotización <strong>100% manual</strong>, hecha
        por un agente físico.<br />
        <strong>AXA · Afirme</strong>, cobertura nacional.
      </p>

      <div class="hero__badges">
        <span class="hero__badge">
          <i class="fas fa-check-circle" aria-hidden="true"></i> Atención personal
        </span>
        <span class="hero__badge">
          <i class="fas fa-phone-alt" aria-hidden="true"></i> Seguimiento real
        </span>
        <span class="hero__badge">
          <i class="fas fa-sync-alt" aria-hidden="true"></i> Renovación anual
        </span>
      </div>

      <div class="hero__logos">
        <span class="hero__logo-badge">
          <img
            src={`${import.meta.env.BASE_URL}logo-axa.webp`}
            alt="Logo AXA"
            width="400"
            height="400"
            class="hero__logo-img"
          />
        </span>
        <span class="hero__logo-badge">
          <img
            src={`${import.meta.env.BASE_URL}logo-afirme.webp`}
            alt="Logo Afirme"
            width="400"
            height="400"
            class="hero__logo-img"
          />
        </span>
        <br /><br />
        <span class="hero__logo-badge hero__logo-badge--transparent">
          <i class="fas fa-map-pin" aria-hidden="true"></i> Cobertura en todo México
        </span>
      </div>
    </div>

    <!-- Cotización en el hero: el formulario es el componente compartido -->
    <div class="hero__form">
      <h2 class="hero__form-title">
        <i class="fas fa-file-signature" aria-hidden="true"></i> Solicita tu cotización
      </h2>
      <p class="hero__form-sub">
        Rellena el formulario y un agente real te contactará en <strong>24h o menos</strong>.
      </p>

      <LeadForm
        source="home-hero"
        context="Formulario del hero de la página de inicio"
        layout="inline"
        theme="dark"
        buttonText="Enviar · cotización manual"
      />
    </div>
  </div>
</section>

<style lang="scss">
  .hero {
    background: linear-gradient(90deg, rgba(255,255,255,1), transparent, transparent, transparent, rgba(255,255,255,1));
    padding: 3.5rem 0 4rem;
    border-bottom: 1px solid #dce1e8;

    @media (max-width: 780px) {
      background: linear-gradient(0deg, rgba(255,255,255,1), rgba(255,255,255,1), rgba(255,255,255,1), rgba(255,255,255,1), rgba(255,255,255,1), rgba(255,255,255,.1));
      padding-block: 5rem;
    }

    picture img {
      @media (max-width: 780px) {
        height: auto;
        min-height: 50vh;
        object-fit: cover;
      }
    }

    &__container {
      max-width: 90%;
      margin: 0 auto;
      padding: 0 1.8rem;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    &__title {
      font-size: 2.8rem;
      font-weight: 800;
      line-height: 1.15;
      color: var(--navy);
    }

    &__highlight {
      color: var(--red-bright);
      background: rgba(230, 57, 70, 0.08);
      padding: 0 0.2rem;
    }

    &__desc {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin: 1.2rem 0 2rem;
      max-width: 90%;
    }

    &__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-top: 1.8rem;

      @media (max-width: 780px) {
        margin-top: 6rem;
      }
    }

    &__badge {
      background: white;
      padding: 0.4rem 1.2rem;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.85rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      border: 1px solid #dce2ec;

      i {
        color: var(--red-bright);
        margin-right: 0.4rem;
      }
    }

    &__logos {
      margin-top: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }

    &__logo-img {
      height: 100px;
      width: auto;
      object-fit: contain;
    }

    &__logo-badge {
      font-weight: 700;
      font-size: 1.1rem;
      border: 1px solid #dce2ec;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
      display: inline-flex;
      align-items: center;

      i {
        color: var(--red-bright);
        margin-right: 0.5rem;
      }

      &--transparent {
        background: transparent;
        border-color: transparent;
        box-shadow: none;
        margin-top: 1rem;
      }
    }

    // ---------- Formulario ----------
    &__form {
      background: var(--navy);
      border-radius: 2rem;
      padding: 2rem 1.8rem;
      color: white;
      box-shadow: 0 20px 40px rgba(11, 37, 69, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.1);
      grid-column: 3;
    }

    &__form-title {
      font-size: 1.6rem;
      font-weight: 600;

      i {
        color: var(--red-bright);
        background: rgba(255, 255, 255, 0.05);
        padding: 0.5rem;
        border-radius: 20px;
        margin-right: 0.5rem;
      }
    }

    &__form-sub {
      color: #fff;
      font-size: 0.95rem;
      margin-top: 0.5rem;
      margin-bottom: 1.2rem;
    }

    // ---------- Responsive ----------
    @media (max-width: 780px) {
      &__container {
        grid-template-columns: 1fr;
        gap: 2rem;
        padding: 0 1rem;
      }

      &__title {
        font-size: 2.2rem;
      }

      &__form {
        grid-column: 1;
        border-radius: 1.5rem;
        padding: 1.8rem 1.2rem;
      }

      &__badges {
        gap: 0.5rem;
      }

      &__badge {
        font-size: 0.78rem;
        padding: 0.35rem 1rem;
      }

      &__logos {
        gap: 0.6rem;
      }

      &__logo-img {
        height: 22px;
      }

      &__logo-badge {
        font-size: 0.95rem;
        padding: 0.25rem 1rem;
      }
    }

    @media (max-width: 540px) {
      padding: 2rem 0 3rem;

      &__title {
        font-size: 1.8rem;
      }

      &__desc {
        font-size: 1rem;
      }

      &__form {
        padding: 1.5rem 1rem;
        border-radius: 1.2rem;
      }

      &__form-title {
        font-size: 1.3rem;
      }
    }
  }
</style>
