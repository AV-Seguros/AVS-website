---
// Sección FAQ con accordion nativo (details/summary)
const faqs = [
  {
    question: '¿Qué diferencia a SeguroReal de un comparador en línea?',
    answer: 'Que detrás hay una persona real. No es un robot, no es un algoritmo. Soy tu agente físico, te doy seguimiento personalizado, resuelvo tus dudas y te acompaño en siniestros y renovaciones.',
    open: true,
  },
  {
    question: '¿Trabajan con más aseguradoras además de AXA y Afirme?',
    answer: 'Por ahora enfocamos nuestros esfuerzos en AXA y Afirme, dos de las aseguradoras con mayor solidez y cobertura en México. Si necesitas otra, podemos evaluarlo caso por caso.',
    open: false,
  },
  {
    question: '¿La cotización es realmente manual?',
    answer: 'Sí, 100% manual. Reviso tus datos, tu perfil y tus necesidades para ofrecerte la mejor opción. No hay automatización que reemplace el criterio humano.',
    open: false,
  },
  {
    question: '¿Cubren todo México?',
    answer: 'Sí, contamos con cobertura nacional. No importa en qué estado te encuentres, puedes contratar con nosotros.',
    open: false,
  },
  {
    question: '¿Qué pasa con las renovaciones anuales?',
    answer: 'La renovación anual también cuenta para nuestro acuerdo. Y si derivas otros seguros (vida, hogar, empresarial), también aplica.',
    open: false,
  },
];
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="faq__container">
    <h2 id="faq-title" class="faq__title">Preguntas frecuentes</h2>
    <p class="faq__sub">Resolvemos tus dudas más comunes antes de que las tengas.</p>
    <div class="faq__grid">
      {faqs.map((faq) => (
        <details class="faq__item" {...(faq.open ? { open: true } : {})}>
          <summary>{faq.question}</summary>
          <div class="faq__answer">{faq.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  .faq {
    background: #f0f4fa;
    padding: 4rem 0;

    &__container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.8rem;
    }

    &__title {
      text-align: center;
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 0.5rem;
    }

    &__sub {
      text-align: center;
      color: var(--text-muted);
      font-size: 1.05rem;
      margin-bottom: 2.5rem;
    }

    &__grid {
      max-width: 820px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    &__item {
      background: white;
      border-radius: 1.2rem;
      padding: 1.2rem 1.8rem;
      border-left: 5px solid var(--red-bright);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);

      summary {
        font-weight: 700;
        font-size: 1.05rem;
        cursor: pointer;
        color: var(--navy);
        display: flex;
        justify-content: space-between;
        align-items: center;
        list-style: none;

        &::-webkit-details-marker {
          display: none;
        }

        &::after {
          content: '\f078';
          font-family: 'Font Awesome 6 Free';
          font-weight: 900;
          color: var(--red-bright);
          font-size: 0.9rem;
          transition: 0.2s;
        }
      }

      &[open] summary::after {
        transform: rotate(180deg);
      }
    }

    &__answer {
      padding-top: 0.8rem;
      color: var(--text-muted);
      font-size: 0.98rem;
      border-top: 1px solid #eef2f6;
      margin-top: 0.6rem;
    }
  }
</style>
